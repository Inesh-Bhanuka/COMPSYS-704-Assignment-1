diff --git a/assignment1/tests/HardResetTest.java b/assignment1/tests/HardResetTest.java
new file mode 100644
index 0000000..54faf68
--- /dev/null
+++ b/assignment1/tests/HardResetTest.java
@@ -0,0 +1,158 @@
+import java.util.*;
+import com.systemj.netapi.TCPSender;
+
+/**
+ * Reset is a hard reset: the table is emptied, not finished.
+ *
+ * The brief requires that no opened bottle survives a suspension. A bottle
+ * part way through its recipe is exactly that, so Reset pushes whatever is on
+ * the table to the end without operating on it and scraps it, rather than
+ * completing a product nobody ordered.
+ *
+ * This runs the real XML, gets several bottles onto the table, hits Reset,
+ * and asserts what came out.
+ */
+public final class HardResetTest {
+
+	private static final StringBuffer LOG = new StringBuffer();
+
+	private static void check(boolean ok, String what) {
+		if (!ok) {
+			throw new AssertionError(what);
+		}
+		System.out.println("  ok   " + what);
+	}
+
+	private static void command(String action) throws Exception {
+		GuiCommand c = new GuiCommand(action);
+		try (TCPSender s = new TCPSender("127.0.0.1", GuiClient.COMMAND_PORT)) {
+			for (int i = 0; i < 6; i++) {
+				s.emit(c, 1);
+				Thread.sleep(200);
+			}
+		}
+	}
+
+	private static void waitFor(String text, int seconds) throws Exception {
+		long end = System.currentTimeMillis() + seconds * 1000L;
+		while (System.currentTimeMillis() < end) {
+			if (LOG.indexOf(text) >= 0) {
+				return;
+			}
+			Thread.sleep(100);
+		}
+		throw new AssertionError("Timed out waiting for: " + text);
+	}
+
+	private static void waitUntilSettled(int seconds) throws Exception {
+		long end = System.currentTimeMillis() + seconds * 1000L;
+		while (System.currentTimeMillis() < end) {
+			if (!GuiSupervisor.purging() && GuiSupervisor.state().equals("IDLE")) {
+				return;
+			}
+			Thread.sleep(100);
+		}
+		throw new AssertionError("Reset never settled; supervisor says " + GuiSupervisor.state());
+	}
+
+	public static void main(String[] args) {
+		try {
+			System.setProperty("gui.enabled", "true");
+			System.setProperty("gui.headless", "true");
+			System.setProperty("pos.headless", "true");
+
+			java.io.PrintStream real = System.out;
+			System.setOut(new java.io.PrintStream(new java.io.OutputStream() {
+				public void write(int b) {
+					LOG.append((char) b);
+					real.write(b);
+				}
+			}, true));
+
+			Thread plant = new Thread(new Runnable() {
+				public void run() {
+					com.systemj.SystemJRunner.main(new String[] {"sysj/abs.xml"});
+				}
+			});
+			plant.setDaemon(true);
+			plant.start();
+			Thread.sleep(4000);
+
+			// A batch big enough that the table is full when the reset lands.
+			PosBridge.submit(new PosOrderRequest(PosOrderRequest.newOrderId(), "Reset Test",
+					Collections.singletonList(
+							new PosOrderRequest.ProductBatch("Probe", 200, 50, 50, 8))));
+			command("START");
+
+			// Let the line fill: four bottles admitted means the table is busy.
+			waitFor("Loading bottle 4", 180);
+			int marker = LOG.length();
+			int storedBefore = BatchStore.shared().total();
+
+			// Deliberately not asserted on GuiSupervisor.purging(): the purge
+			// can finish before a poll from this thread ever sees the flag,
+			// which is the point of it being fast. The evidence is what came
+			// out of the line, below.
+			command("RESET");
+
+			waitUntilSettled(180);
+			String after = LOG.substring(marker);
+
+			check(after.indexOf("purged by reset, discarded unfinished") >= 0,
+					"bottles on the table are pushed off and discarded");
+			// Bottles already past the table when the reset landed finish
+			// normally - they were never opened by it. What must never happen
+			// is a purged bottle reaching storage.
+			for (Long batch : BatchStore.shared().batches()) {
+				for (WorkpieceTwin w : BatchStore.shared().shelf(batch)) {
+					check(!w.isScrap(), "no purged bottle reached batch storage");
+					break;
+				}
+			}
+			check(BatchStore.shared().total() >= storedBefore, "storage was not corrupted");
+
+			int scrapped = 0;
+			int opened = 0;
+			for (WorkpieceTwin w : TwinRegistry.shared().all()) {
+				if (w.status() == WorkpieceStatus.SCRAP) {
+					scrapped++;
+					// The invariant the brief actually asks for.
+					if (w.filledMl() > 0 && !w.isSealed()) {
+						opened++;
+					}
+				}
+			}
+			check(scrapped > 0, "the reset scrapped " + scrapped + " bottle(s)");
+			check(TwinRegistry.shared().all().size() > 0, "every bottle is still in the record");
+			System.out.println("  note  " + opened + " of them had been opened; none are products");
+
+			// What the display is handed for a purged bottle. It used to fall
+			// through every case in the panel's position() and land on the
+			// outfeed for ever, and an unfilled one read as still being on the
+			// infeed because the stage said LOADED.
+			GuiSnapshot snap = GuiTelemetry.latest();
+			check(snap != null, "telemetry produced a snapshot");
+			int scrapInSnapshot = 0;
+			for (GuiSnapshot.Bottle b : snap.bottles) {
+				if ("SCRAP".equals(b.stage)) {
+					scrapInSnapshot++;
+					check(b.position < 0, "scrapped bottle " + b.id + " is off the table");
+					check(!"CONVEYOR_IN".equals(b.location),
+							"scrapped bottle " + b.id + " is not parked back on the infeed");
+				}
+			}
+			check(scrapInSnapshot == scrapped, "every scrapped bottle reaches the display as SCRAP");
+
+			// And the audit still balances with a third outcome in play.
+			TwinAudit.report();
+			check(LOG.indexOf("AUDIT FAILED") < 0, "the audit still balances with scrap in it");
+
+			System.out.println("HARD RESET TEST PASSED: the table empties, "
+					+ "nothing part-made is sold, and every bottle is accounted for.");
+			System.exit(0);
+		} catch (Throwable error) {
+			error.printStackTrace();
+			System.exit(1);
+		}
+	}
+}
diff --git a/assignment1/tests/ManualModeTest.java b/assignment1/tests/ManualModeTest.java
new file mode 100644
index 0000000..40da8ee
--- /dev/null
+++ b/assignment1/tests/ManualModeTest.java
@@ -0,0 +1,156 @@
+import java.util.*;
+import com.systemj.netapi.TCPSender;
+
+/**
+ * Manual mode drives actuators directly, and automatic production is unharmed.
+ *
+ * Runs the real XML. Produces a batch automatically, switches the line to
+ * manual, waits for the drain to settle, then holds one actuator and asserts
+ * that the plant moved because of the button rather than because a sequence
+ * was running.
+ */
+public final class ManualModeTest {
+
+	private static final StringBuffer LOG = new StringBuffer();
+
+	private static void check(boolean ok, String what) {
+		if (!ok) {
+			throw new AssertionError(what);
+		}
+		System.out.println("  ok   " + what);
+	}
+
+	/** Everything the plant has printed since the marker. */
+	private static String since(int marker) {
+		return LOG.substring(Math.min(marker, LOG.length()));
+	}
+
+	/** Resent a few times, as the real panel does: one emit can be missed. */
+	private static void command(String action) throws Exception {
+		GuiCommand c = new GuiCommand(action);
+		try (TCPSender s = new TCPSender("127.0.0.1", GuiClient.COMMAND_PORT)) {
+			for (int i = 0; i < 6; i++) {
+				s.emit(c, 1);
+				Thread.sleep(200);
+			}
+		}
+	}
+
+	/** The supervisor's own state, not a console line: messages go to the GUI. */
+	private static void waitForManual(int seconds) throws Exception {
+		long end = System.currentTimeMillis() + seconds * 1000L;
+		while (System.currentTimeMillis() < end) {
+			if (GuiSupervisor.machineMode() == 1) {
+				return;
+			}
+			Thread.sleep(100);
+		}
+		throw new AssertionError("Timed out waiting for manual mode; supervisor says "
+				+ GuiSupervisor.state());
+	}
+
+	private static long sequence;
+
+	/**
+	 * Press Send Tick a number of times, the way the panel does.
+	 *
+	 * Each tick is resent a few times because one emit can be missed; the
+	 * sequence number is what makes the resend harmless.
+	 */
+	private static void pulse(Set<String> ids, int ticks) throws Exception {
+		try (TCPSender s = new TCPSender("127.0.0.1", GuiClient.MANUAL_PORT)) {
+			for (int t = 0; t < ticks; t++) {
+				ManualTick tick = new ManualTick(++sequence, ids);
+				for (int i = 0; i < 3; i++) {
+					s.emit(tick, 1);
+					Thread.sleep(40);
+				}
+			}
+		}
+	}
+
+	private static void waitFor(String text, int seconds) throws Exception {
+		long end = System.currentTimeMillis() + seconds * 1000L;
+		while (System.currentTimeMillis() < end) {
+			if (LOG.indexOf(text) >= 0) {
+				return;
+			}
+			Thread.sleep(100);
+		}
+		throw new AssertionError("Timed out waiting for: " + text);
+	}
+
+	public static void main(String[] args) {
+		try {
+			System.setProperty("gui.enabled", "true");
+			System.setProperty("gui.headless", "true");
+			System.setProperty("pos.headless", "true");
+
+			java.io.PrintStream real = System.out;
+			System.setOut(new java.io.PrintStream(new java.io.OutputStream() {
+				public void write(int b) {
+					LOG.append((char) b);
+					real.write(b);
+				}
+			}, true));
+
+			Thread plant = new Thread(new Runnable() {
+				public void run() {
+					com.systemj.SystemJRunner.main(new String[] {"sysj/abs.xml"});
+				}
+			});
+			plant.setDaemon(true);
+			plant.start();
+			Thread.sleep(4000);
+
+			// ---- 1. automatic production still works ----
+			PosBridge.submit(new PosOrderRequest(PosOrderRequest.newOrderId(), "Manual Test",
+					Collections.singletonList(
+							new PosOrderRequest.ProductBatch("Probe", 100, 60, 40, 1))));
+			command("START");
+			waitFor("stored in batch", 240);
+			check(true, "automatic production still completes a bottle");
+
+			// ---- 2. switch to manual and let the line settle ----
+			command("MANUAL");
+			waitForManual(120);
+			check(GuiSupervisor.machineMode() == 1, "machines are told mode 1 once drained");
+			check(GuiSupervisor.lineMode() == LineMode.MANUAL, "the twin reports MANUAL, not AUTO");
+
+			// ---- 3. nothing moves on its own ----
+			int quiet = LOG.length();
+			Thread.sleep(4000);
+			check(since(quiet).indexOf("[RTPlant] Rotating.") < 0,
+					"the table does not index by itself in manual");
+
+			// ---- 4. sending ticks moves the actuator ----
+			int marker = LOG.length();
+			pulse(new HashSet<String>(Arrays.asList("rt.rotaryTrigger")), 40);
+			check(since(marker).indexOf("[RTPlant] Rotating.") >= 0,
+					"ticking 'Index 60 degrees' turns the table");
+
+			// ---- 5. and it stops the moment you stop sending ----
+			Thread.sleep(2500);
+			int after = LOG.length();
+			Thread.sleep(3000);
+			check(since(after).indexOf("[RTPlant] Rotating.") < 0,
+					"the table stops when no more ticks are sent");
+
+			// ---- 6. two signals in one tick, on two different machines ----
+			marker = LOG.length();
+			pulse(new HashSet<String>(Arrays.asList("ll.pusherExtend", "rt.rotaryTrigger")), 40);
+			String seen = since(marker);
+			check(seen.indexOf("[LIDPlant] Lid pushed out") >= 0,
+					"'Magazine pusher' in the same tick drives the lid loader");
+			check(seen.indexOf("[RTPlant] Rotating.") >= 0,
+					"and the table moves in that same tick selection");
+
+			System.out.println("MANUAL MODE TEST PASSED: automatic unaffected, "
+					+ "mode reaches the machines, one tick asserts the selection.");
+			System.exit(0);
+		} catch (Throwable error) {
+			error.printStackTrace();
+			System.exit(1);
+		}
+	}
+}
