diff --git a/assignment1/sysj/rotaryTableController.sysj b/assignment1/sysj/rotaryTableController.sysj
index 47a3626..7d902cf 100644
--- a/assignment1/sysj/rotaryTableController.sysj
+++ b/assignment1/sysj/rotaryTableController.sysj
@@ -49,13 +49,38 @@ RotaryTableController(
 
 		// to the plant
 		output signal rotaryTrigger, loadPos1, unloadExit;
+
+		// operating mode
+		input Integer signal mode;
+
+		// manual overrides - the operator panel attaches here
+		input signal rotaryTriggerM;
 		)
 ->
 {
 	// Local signal: the sequencer tells the intake reaction that the bottle
 	// it accepted has been placed, so it may accept another.
 	signal placed;
+	signal auto, manual;
 
+	{ // Mode select
+		while(true){
+			present(mode){
+				if((Integer)#mode == 0){ emit auto; }
+				else { emit manual; }
+			}
+			pause;
+		}
+	}
+	||
+	{ // Auto
+		//
+		// Sequencer and intake drop together. The barrier holds four stations
+		// against one table, so half a table in manual would deadlock the
