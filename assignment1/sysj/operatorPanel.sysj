/*
 * Operator panel.
 *
 * The manual counterpart to the System Controller: where that one runs the
 * automatic production plan, this one carries an operator's hands onto the
 * plant. Each output is wired to one machine's manual input for one actuator,
 * so a press here asserts exactly one actuator signal and nothing else
 * decides what it means.
 *
 * Every controller ignores these while its mode input reads 0, so this domain
 * can emit freely and the plant only listens once the line is genuinely in
 * manual. That keeps the arbitration in one place - the mode signal - rather
 * than spread across thirteen machines.
 *
 * ManualDrive is a mailbox filled by the GUI on its own thread, never read
 * from a socket inside a tick. It expires by itself if the panel stops
 * talking, so a closed window or a dropped connection releases every actuator
 * rather than leaving one asserted.
 *
 * GENERATED by tools/actuators.py - edit the table there, not this file.
 */
OperatorPanel(
		output signal blVacOn, blRelease, blArmSource, blArmDest;
		output signal cvMotInfeed, cvTakeFromPos1, cvMotOutfeed, cvInjectInfeed;
		output signal cvInjectOutfeed, cvCollectFromEnd, rtRotaryTrigger, rtLoadPos1;
		output signal rtUnloadExit, f1ValveOpen, f2ValveOpen, llPusherExtend;
		output signal llVacOn, llArmSource, llArmDest, llRefill;
		output signal cpScrewOn, lbApplyLabelExtend, lbApplyLabelRetract, lbRollerOnOff;
		output signal spDiverterExtend, spDiverterRetract, spAdmitBottle, rcRecyclingConveyorMotor;
		output signal rcInjectAtEntry, rcCollectAtReturn, lrCylZaxisExtend, lrUnscrewTurnExtend;
		output signal lrUnscrewTurnRetract, lrLidGripperExtend, lrLidEjectExtend, ldCylClampBottleExtend;
		output signal ldInvertRotateExtend, ldInvertRotateRetract, ldDrainValveOnOff, brMotorOnOff;
		output signal brTransferArmExtend, brTransferArmRetract;
		)
->
{
	{ // Bottle loader
		while(true){
			if(ManualDrive.held("bl.vacOn")){ emit blVacOn; }
			if(ManualDrive.held("bl.release")){ emit blRelease; }
			if(ManualDrive.held("bl.armSource")){ emit blArmSource; }
			if(ManualDrive.held("bl.armDest")){ emit blArmDest; }
			pause;
		}
	}
	||
	{ // Conveyor
		while(true){
			if(ManualDrive.held("cv.motInfeed")){ emit cvMotInfeed; }
			if(ManualDrive.held("cv.takeFromPos1")){ emit cvTakeFromPos1; }
			if(ManualDrive.held("cv.motOutfeed")){ emit cvMotOutfeed; }
			if(ManualDrive.held("cv.injectInfeed")){ emit cvInjectInfeed; }
			if(ManualDrive.held("cv.injectOutfeed")){ emit cvInjectOutfeed; }
			if(ManualDrive.held("cv.collectFromEnd")){ emit cvCollectFromEnd; }
			pause;
		}
	}
	||
	{ // Rotary table
		while(true){
			if(ManualDrive.held("rt.rotaryTrigger")){ emit rtRotaryTrigger; }
			if(ManualDrive.held("rt.loadPos1")){ emit rtLoadPos1; }
			if(ManualDrive.held("rt.unloadExit")){ emit rtUnloadExit; }
			pause;
		}
	}
	||
	{ // Filler 1
		while(true){
			if(ManualDrive.held("f1.valveOpen")){ emit f1ValveOpen; }
			pause;
		}
	}
	||
	{ // Filler 2
		while(true){
			if(ManualDrive.held("f2.valveOpen")){ emit f2ValveOpen; }
			pause;
		}
	}
	||
	{ // Lid loader
		while(true){
			if(ManualDrive.held("ll.pusherExtend")){ emit llPusherExtend; }
			if(ManualDrive.held("ll.vacOn")){ emit llVacOn; }
			if(ManualDrive.held("ll.armSource")){ emit llArmSource; }
			if(ManualDrive.held("ll.armDest")){ emit llArmDest; }
			if(ManualDrive.held("ll.refill")){ emit llRefill; }
			pause;
		}
	}
	||
	{ // Capper
		while(true){
			if(ManualDrive.held("cp.screwOn")){ emit cpScrewOn; }
			pause;
		}
	}
	||
	{ // Labeller
		while(true){
			if(ManualDrive.held("lb.applyLabelExtend")){ emit lbApplyLabelExtend; }
			if(ManualDrive.held("lb.applyLabelRetract")){ emit lbApplyLabelRetract; }
			if(ManualDrive.held("lb.rollerOnOff")){ emit lbRollerOnOff; }
			pause;
		}
	}
	||
	{ // Quality splitter
		while(true){
			if(ManualDrive.held("sp.diverterExtend")){ emit spDiverterExtend; }
			if(ManualDrive.held("sp.diverterRetract")){ emit spDiverterRetract; }
			if(ManualDrive.held("sp.admitBottle")){ emit spAdmitBottle; }
			pause;
		}
	}
	||
	{ // Recycling conveyor
		while(true){
			if(ManualDrive.held("rc.recyclingConveyorMotor")){ emit rcRecyclingConveyorMotor; }
			if(ManualDrive.held("rc.injectAtEntry")){ emit rcInjectAtEntry; }
			if(ManualDrive.held("rc.collectAtReturn")){ emit rcCollectAtReturn; }
			pause;
		}
	}
	||
	{ // Lid removal
		while(true){
			if(ManualDrive.held("lr.cylZaxisExtend")){ emit lrCylZaxisExtend; }
			if(ManualDrive.held("lr.unscrewTurnExtend")){ emit lrUnscrewTurnExtend; }
			if(ManualDrive.held("lr.unscrewTurnRetract")){ emit lrUnscrewTurnRetract; }
			if(ManualDrive.held("lr.lidGripperExtend")){ emit lrLidGripperExtend; }
			if(ManualDrive.held("lr.lidEjectExtend")){ emit lrLidEjectExtend; }
			pause;
		}
	}
	||
	{ // Liquid dumper
		while(true){
			if(ManualDrive.held("ld.cylClampBottleExtend")){ emit ldCylClampBottleExtend; }
			if(ManualDrive.held("ld.invertRotateExtend")){ emit ldInvertRotateExtend; }
			if(ManualDrive.held("ld.invertRotateRetract")){ emit ldInvertRotateRetract; }
			if(ManualDrive.held("ld.drainValveOnOff")){ emit ldDrainValveOnOff; }
			pause;
		}
	}
	||
	{ // Bottle return
		while(true){
			if(ManualDrive.held("br.motorOnOff")){ emit brMotorOnOff; }
			if(ManualDrive.held("br.transferArmExtend")){ emit brTransferArmExtend; }
			if(ManualDrive.held("br.transferArmRetract")){ emit brTransferArmRetract; }
			pause;
		}
	}
}
