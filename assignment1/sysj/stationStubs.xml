<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS13" Local="true">
		<ClockDomain Name="StationStubsCD" Class="StationStubs">
			<!-- StationStubsCD listens on 13003 -->
			<iSignal Name="enable"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13003" />
			<iSignal Name="enableFiller1" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13003" />
			<iSignal Name="enableFiller2" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13003" />
			<iSignal Name="enableLid"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13003" />
			<iSignal Name="enableCapper" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13003" />

			<oSignal Name="fillerDone1" To="RotaryTableControllerCD.fillerDone1" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="fillerDone2" To="RotaryTableControllerCD.fillerDone2" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="lidDone"    To="RotaryTableControllerCD.lidDone"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="capperDone" To="RotaryTableControllerCD.capperDone" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
		</ClockDomain>
	</SubSystem>
</System>