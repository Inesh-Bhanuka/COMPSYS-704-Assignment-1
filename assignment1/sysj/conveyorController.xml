<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS8" Local="true">
		<ClockDomain Name="ConveyorControllerCD" Class="ConveyorController">
			<!-- ConveyorControllerCD listens on 12000 -->

			<!-- from the bottle loader (11000) -->
			<iSignal Name="bottlePlaced"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />

			<!-- from the plant -->
			<iSignal Name="bottleAtPos1"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="infeedClear"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="bottleAtOutfeedEnd" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="outfeedClear"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />

			<!-- from the turntable -->
			<iSignal Name="tableReady"         Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="bottleFromTable"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="bottleTaken"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />

			<!-- to the bottle loader (11000) -->
			<oSignal Name="conveyorReady"   To="BottleLoaderControllerCD.conveyorReady" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />

			<!-- to the plant (12001) -->
			<oSignal Name="motInfeed"       To="ConveyorPlantCD.motInfeed"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="injectInfeed"    To="ConveyorPlantCD.injectInfeed"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="takeFromPos1"    To="ConveyorPlantCD.takeFromPos1"   Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="motOutfeed"      To="ConveyorPlantCD.motOutfeed"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="injectOutfeed"   To="ConveyorPlantCD.injectOutfeed"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="collectFromEnd"  To="ConveyorPlantCD.collectFromEnd" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />

			<!-- to the turntable (12003) -->
			<oSignal Name="bottleToTable" To="RotaryTableControllerCD.bottleToTable" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />

			<!-- to the system controller (12002) -->
			<oSignal Name="bottleAtLabeller" To="SystemControllerCD.bottleAtLabeller" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12002" />
		</ClockDomain>
	</SubSystem>
</System>