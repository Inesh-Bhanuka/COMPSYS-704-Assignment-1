<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS4" Local="true">
		<ClockDomain Name="ConveyorStubCD" Class="ConveyorStub">
			<!-- ConveyorStubCD listens on 11003 -->
			<iSignal Name="enable"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11003" />
			<iSignal Name="bottlePlaced"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11003" />

			<oSignal Name="conveyorReady" To="BottleLoaderControllerCD.conveyorReady" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
		</ClockDomain>
	</SubSystem>
</System>