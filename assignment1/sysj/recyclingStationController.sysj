/*
 * Recycling Station Controller (RSC).
 *
 * The only machine in the station the ABS System Controller talks to, and a
 * subordinate coordinator rather than a peer: the coordinator delegates the
 * recovery of a rejected bottle and waits for a completion notification. Like
 * the System Controller and the rotary table it drives no plant, so it has no
 * operating mode of its own - the machines beneath it each carry theirs.
 *
 * Interface
 *
 *   bottleRejected    channel, SC -> RSC. The twin of a bottle the splitter
 *                     has diverted onto the belt. A channel, not a signal,
 *                     because it carries the bottle and its history rather
 *                     than the bare fact of a rejection.
 *   bottleRecycled    channel, RSC -> SC. One per recovered container.
 *   recyclingStatus   valued signal, RSC -> SC. A level the coordinator may
 *                     sample at any point: 0 idle, 1 busy, 2 suspended or
 *                     faulted, 3 running with a bin or tank warning.
 *
 * Every sensor and actuator stays local to its own controller-plant pair.
 *
 * Sequencing
 *
 * Recycling is strictly sequential, so the sequencer is a single straight
 * line: enable a stage, await its status, enable the next. Nothing inside the
 * station runs concurrently, and the conveyor is enabled between processing
 * stages because position sensing is centralised there.
 *
 */
RecyclingStationController(

		// to / from the ABS System Controller
		input  WorkpieceTwin channel bottleRejected;
		output WorkpieceTwin channel bottleRecycled;
		output Integer signal recyclingStatus;

		// enable, one per processing station
		output WorkpieceTwin channel enableLidRemoval, enableDumper, enableReturn;
		output Integer channel enableConveyor;

		// status, one per subsystem
		input  Integer channel statusConveyor, statusLidRemoval;
		input  Integer channel statusDumper, statusReturn;

		// Hard reset: abandon the recovery in progress and the queue behind
		// it. The bottles are gone from the line, so there is nothing left
		// to recover.
		input signal reset;
		)
->
{
	while(true){
		abort(immediate reset){
		// The sequencer blocks inside rendezvous, so it cannot also drive a level
		// out every tick. It posts the station's state on this local valued
		// signal and a second reaction holds it out to the System Controller.
		int signal stationState;

		{ // ---- Station status, held out as a level ----
			int cur = 0;
			while(true){
				present(stationState){
					cur = ((Integer)#stationState).intValue();
				}
				emit recyclingStatus(cur);
				pause;
			}
		}
		||
		{ // ---- Intake ----
			//
			// The station advertises no readiness level: being parked at this
			// receive IS the readiness, and the coordinator's send completes only
			// when the station has actually taken the workpiece. That is the
			// back-pressure, and with the queue in front of the sequencer it
			// only bites once five bottles are already waiting.
			RecyclingQueue q = RecyclingQueue.shared();
			RecyclingRecord m = RecyclingRecord.shared();
			WorkpieceTwin w = null;

			while(true){
				while(!q.hasRoom()){
					pause;
				}
				receive bottleRejected;
				w = (WorkpieceTwin)#bottleRejected;

				// Record the handover here rather than leaving it until the lid
				// comes off. The station owns the bottle from this tick, and a
				// display reading the twin should say so immediately instead of
				// leaving it parked on the splitter for the whole transit.
				w.arrived(Machine.RECYCLING);
				m.accepted(w);
				q.push(w);
				pause;
			}
		}
		||
		{ // ---- Sequencer ----
			RecyclingQueue q = RecyclingQueue.shared();
			RecyclingRecord m = RecyclingRecord.shared();

			// Recycling conveyor destinations
			int TO_LID = 1;
			int TO_DUMP = 2;
			int TO_RETURN = 3;
			int DISCHARGE = 4;

			WorkpieceTwin w = null;
			boolean permitted = false;

			while(true){

				// Nothing waiting: hold the resting level and idle here.
				while(!q.hasWork()){
					pause;
				}

				w = q.take();
				m.beginCycle(w);
				emit stationState(1);


				// ---- 1. Admit the bottle and index it to lid removal ----
				send enableConveyor(new Integer(TO_LID));
				receive statusConveyor;
				m.record(((Integer)#statusConveyor).intValue());
				pause;

				// ---- 2. Lid removal ----
				send enableLidRemoval(w);
				receive statusLidRemoval;
				m.record(((Integer)#statusLidRemoval).intValue());
				pause;

				// ---- 3. Index to the liquid dumper ----
				send enableConveyor(new Integer(TO_DUMP));
				receive statusConveyor;
				m.record(((Integer)#statusConveyor).intValue());
				pause;

				// ---- 4. Liquid dumping ----
				send enableDumper(w);
				receive statusDumper;
				m.record(((Integer)#statusDumper).intValue());
				pause;

				// ---- 5. Index to the bottle return ----
				send enableConveyor(new Integer(TO_RETURN));
				receive statusConveyor;
				m.record(((Integer)#statusConveyor).intValue());
				pause;

				// ---- 6. Hand the bottle off the recycling conveyor ----
				send enableConveyor(new Integer(DISCHARGE));
				receive statusConveyor;
				m.record(((Integer)#statusConveyor).intValue());
				pause;

				// ---- 7. Bottle return ----
				send enableReturn(w);
				receive statusReturn;
				m.record(((Integer)#statusReturn).intValue());
				pause;

				// ---- 8. Close the transaction ----
				m.recovered(w);
				send bottleRecycled(w);
				pause;

				// Busy while anything is still queued behind this one, otherwise
				// idle - with a bin or tank warning folded in if one was raised.
				emit stationState(m.levelFor(q.hasWork()));

				// A full bin is not something this station can clear on its own.
				// It holds the condition out as a level and stops taking work;
				// the coordinator's next send then simply does not complete, so
				// the back-pressure propagates on its own. The bottle in progress
				// is always finished first, which is what keeps the suspension at
				// a clean boundary.
				if(m.suspended()){
					m.reportSuspension();
					while(true){
						emit stationState(2);
						pause;
					}
				}
				pause;
			}
		}
		}
		pause;
	}
}
