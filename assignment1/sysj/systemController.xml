<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS3" Local="true">
		<ClockDomain Name="SystemControllerCD" Class="SystemController">
			<!-- SystemControllerCD listens on 11002 -->
			<iSignal Name="bottleLoaded" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11002" />

			<!-- to the bottle loader controller (11000) -->
			<oSignal Name="mode"       To="BottleLoaderControllerCD.mode"       Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
			<oSignal Name="bottleLoad" To="BottleLoaderControllerCD.bottleLoad" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />

			<!-- one enable per machine: an oSignal has a single destination -->
			<oSignal Name="enable"     To="BottleLoaderPlantCD.enable"          Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
			<oSignal Name="enableCV"   To="ConveyorStubCD.enable"               Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11003" />
		</ClockDomain>
	</SubSystem>
</System>