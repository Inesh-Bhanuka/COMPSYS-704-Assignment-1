/*
 * Lid loader plant: a magazine with a pusher, and a vacuum arm that moves
 * between the pick-up point and the bottle.
 */
LidLoaderPlant(
		input signal enable;
		input signal pusherExtend, vacOn, armSource, armDest, refill;

		output signal pusherExtended, pusherRetracted, lidAtPickup, WPgripped;
		output signal armAtSource, armAtDest, magazineEmpty, refilled;
		)
->
{
	{ // Arm: reports the end it is sitting at
		while(true){
			abort(armSource && enable){
				sustain armAtDest;
			}
			abort(armDest && enable){
				sustain armAtSource;
			}
		}
	}
	||
	{ // Pusher, magazine and gripper
		int STOCK = 3;   // small on purpose, so a refill happens during a demo run
		int lids = STOCK;
		boolean extended = false;
		boolean lidReady = false;
		boolean holding = false;

		while(true){
			present(enable){

				// Pusher follows the command directly
				present(pusherExtend){
					if(!extended){
						extended = true;
						if(lids > 0 && !lidReady){
							lids--;
							lidReady = true;
							System.out.println("[LIDPlant] Lid pushed out, " + lids + " left.");
						}
					}
					emit pusherExtended;
				}
				else {
					extended = false;
					emit pusherRetracted;
				}

				// Vacuum picks up whatever is at the pick-up point
				if(holding){
					present(vacOn){
						// still holding
					}
					else {
						holding = false;
						System.out.println("[LIDPlant] Lid released.");
					}
				}
				else {
					present(vacOn && armAtSource){
						if(lidReady){
							lidReady = false;
							holding = true;
						}
					}
				}

				if(lidReady){ emit lidAtPickup; }
				if(holding){ emit WPgripped; }

				present(refill){
					lids = STOCK;
					emit refilled;
				}
				else if(lids == 0 && !lidReady && !holding){
					emit magazineEmpty;
				}
			}
			pause;
		}
	}
}
