/*
 * Splitter Controller - the quality diverter at the end of the outfeed.
 *
 * The Splitter sits in the main production flow and is where the Recycling
 * Station attaches to the core ABS. It belongs to the System Controller, not
 * to the station: the coordinator hands it every bottle leaving the outfeed,
 * it reads the quality record off the twin it is holding, and it drives the
 * diverter it already senses. 
 *
 * admitBottle is the outfeed releasing the claimed workpiece towards the
 * decision point.
 */
SplitterController(
		// from / to the System Controller
		input  WorkpieceTwin channel enable;
		output Integer channel status;

		// operating mode
		input Integer signal mode;

		// Hard reset: drop whatever is held and go back to idle. One tick,
		// no sequence to finish - the bottle it was working on no longer
		// exists anywhere else either.
		input signal reset;

		// from the Diverter Plant
		input signal bottleAtSplitter, divertAtNormal, divertAtReject, bottleLeftSplitter;

		// to the Diverter Plant
		output signal admitBottle, diverterExtend, diverterRetract;

		// manual overrides - the operator panel attaches here
		input signal diverterExtendM, diverterRetractM;
		input signal admitBottleM;
		)
->
{
	signal auto, manual;

	// Either diverter button is the same request to the sequencer: the
	// record has already decided which way the flap goes, so folding the
	// two inputs into one local signal here keeps the branch out of the
	// sequencer, where every extra control path is paid for twice over in
	// the generated state machine.
	signal diverterM;

	{ // Manual diverter request, either direction
		while(true){
			present(diverterExtendM){ emit diverterM; }
			present(diverterRetractM){ emit diverterM; }
			pause;
		}
	}
	||
	{ // Mode select
		while(true){
			present(mode){
				// 0 automatic, 1 manual, 2 paused. Paused emits neither, so
				// every gate below waits and the operator panel is inert.
				if((Integer)#mode == 0){ emit auto; }
				else if((Integer)#mode == 1){ emit manual; }
			}
			pause;
		}
	}
	||
	{ // Auto
		// Route reported back to the coordinator
		int FORWARD = 0;   // normal path, on to the labeller
		int DIVERTED = 1;  // reject path, onto the recycling conveyor
		int JAMMED = 2;    // the diverter did not reach the commanded position

		// The diverter is a pneumatic stroke. If the commanded end stop has
		// not answered within this many ticks it has not moved.
		int STROKE_TIMEOUT = PlantTiming.ticks(12);

		WorkpieceTwin w = null;
		int t = 0;
		int code = 0;
		boolean reject = false;
		boolean confirmed = false;
		boolean cleared = false;
		boolean home = false;

		while(true){
			abort(immediate reset){
				receive enable;
				w = (WorkpieceTwin)#enable;

				// Claim the workpiece and wait for it to reach the decision
				// point. The command is held until the plant's arrival sensor
				// answers, rather than pulsed for a guessed number of ticks.
				abort(immediate auto){ await(immediate admitBottleM); }
				abort(immediate bottleAtSplitter){
					sustain admitBottle;
				}

				// The decision, read off the record the bottle is carrying.
				reject = w.isRejected();
				w.arrived(Machine.SPLITTER);
				System.out.println("[SP] " + w + " at the decision point - "
						+ (reject ? "reject path (" + w.defect() + ")" : "normal path") + ".");

				// Load Bearing
				pause;

				abort(immediate auto){ await(immediate diverterM); }
				t = STROKE_TIMEOUT;
				confirmed = false;
				while(t > 0 && !confirmed){
					if(reject){ emit diverterExtend; }
					if(!reject){ emit diverterRetract; }
					if(reject){
						present(divertAtReject){ confirmed = true; }
					}
					if(!reject){
						present(divertAtNormal){ confirmed = true; }
					}
					t--;
					pause;
				}

				code = JAMMED;

				if(confirmed){
					// Hold the diverter on the selected path until the bottle
					// has physically cleared it.
					cleared = false;
					while(!cleared){
						if(reject){ emit diverterExtend; }
						if(!reject){ emit diverterRetract; }
						present(bottleLeftSplitter){ cleared = true; }
						pause;
					}
					code = FORWARD;
					if(reject){ code = DIVERTED; }
					System.out.println("[SP] " + w + " released down the "
							+ (reject ? "reject path to the recycling conveyor" : "normal path to the labeller") + ".");
				}

				if(!confirmed){
					// The mechanism did not select the path that was asked
					// for. Record it on the bottle so the labeller's own
					// check becomes the backstop, and do not claim a route
					// that was not taken.
					System.out.println("[SP] FAULT: diverter did not reach the "
							+ (reject ? "reject" : "normal") + " position for " + w + ".");
					w.reject(Machine.SPLITTER, "diverter jammed");
					cleared = false;
					while(!cleared){
						present(bottleLeftSplitter){ cleared = true; }
						pause;
					}
				}

				// Reset to the normal path so the next accepted bottle runs
				// straight through.
				//
				// Deliberately not gated. This is the flap returning to rest after
				// the bottle has already cleared it, not a move that carries the
				// bottle anywhere, so asking the operator for a tick here would add
				// a button press that changes nothing. It is also the one place a
				// gate would not fit: a second abort in this reaction takes the
				// compiler past 3 GB, and the sequencer's timeout loops are already
				// the most branch-heavy in the project.
				home = false;
				while(!home){
					emit diverterRetract;
					present(divertAtNormal){ home = true; }
					pause;
				}

				// One status transfer per cycle, whatever the outcome. A
				// rendezvous inside a branch multiplies the control paths
				// through the reaction and the generated state machine grows
				// with every one of them.
				send status(new Integer(code));
			}
		

			pause;
		}
	}
}
