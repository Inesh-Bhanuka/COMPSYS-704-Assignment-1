/*
 * Liquid filler. Two of these run on the line - one at table position 2 for
 * liquid A, one at position 3 for liquid B - so the code asks the bottle what
 * it needs next rather than being told which liquid it is.
 *
 * Fill time comes out of the volume, so a 200ml bottle takes twice as long as
 * a 100ml one at the same percentage.
 */
FillerController(
		// from / to the Rotary Table
		input  WorkpieceTwin channel start;
		output WorkpieceTwin channel done;

		// the machine's own summary, out to the coordinator
		output FillerTwin signal twin;

		// operating mode
		input Integer signal mode;

		// Hard reset: drop whatever is held and go back to idle. One tick,
		// no sequence to finish - the bottle it was working on no longer
		// exists anywhere else either.
		input signal reset;

		// to / from the plant
		output Integer signal fillTarget;
		output signal valveOpen;
		input  signal filled;

		// manual override - the operator panel attaches here
		input signal valveOpenM;
		)
->
{
	signal auto, manual;

	{ // Mode select
		while(true){
			present(mode){
				// 0 automatic, 1 manual, 2 paused. Paused emits neither, so
				// every gate below waits and the operator panel is inert.
				if((Integer)#mode == 0){ emit auto; }
				else if((Integer)#mode == 1){ emit manual; }
			}
			pause;
		}
	}
	||
	{ // Auto
		FillerTwin t = new FillerTwin();
		WorkpieceTwin w = null;
		int ml = 0;
		int asked = 0;
		boolean lidded = false;

		while(true){
			abort(immediate reset){
				receive start;
				w = (WorkpieceTwin)#start;


				ml = (w == null) ? 0 : w.nextVolumeMl();
				asked = ml;

				// ---- A bottle that arrived with a lid already on it ----
				//
				// Caught here rather than at the lid loader, which is two
				// table positions further on. By the time the loader looked,
				// the bottle had already been filled - the log read "250ml
				// into bottle 3" and then, two positions later, "bottle 3
				// already has a lid fitted". Pouring into a sealed container
				// is not something a plant can do, so a model that reports it
				// is wrong whatever it does afterwards. The first filler is
				// the first station the bottle meets and the first with a
				// reason to care, so it is caught here and no liquid goes in.
				//
				// The lid is recorded on the workpiece because it is true:
				// the container really does have a lid, however it got there,
				// and every station downstream - including the recycling
				// station that has to unscrew it - needs to know. That is
				// also what makes the second filler skip the bottle without
				// being told separately: it asks, and the bottle already
				// knows. The decision is taken here rather than inside the
				// workpiece, which only records and answers questions.
				lidded = false;
				if(w != null){
					if(w.catchFault("lid-fitted")){
						w.lid();
						w.reject(Machine.FILLER, "arrived with a lid already fitted");
					}
					lidded = w.isLidded();
				}

				if(lidded){
					System.out.println("[FILL] " + w + " has a lid fitted - refusing to fill.");
					if(t.update(PlantClock.now(), MachineStatus.FAULT, "refuse", "lid fitted")){
						emit twin(t);
					}
				}
				else if(ml == 0){
					// Record a zero-percent ingredient so the next station advances
					// to Liquid 2 and the label has both measurements.
					if(w != null){
						w.dispensed(0);
						w.completed(Machine.FILLER, "zero-percent ingredient");
					}
				}
				else if(!w.fits(ml)){
					// Overflow interlock: refuse rather than dispense.
					System.out.println("[FILL] Refusing " + ml + "ml into " + w + " - would overflow.");
					w.reject(Machine.FILLER, "would overflow");
					if(t.update(PlantClock.now(), MachineStatus.FAULT, "refuse", "overflow")){
						emit twin(t);
					}
				}
				else {
					// An armed misfill makes the plant dispense short. The
					// filler still measures what actually went in.
					if(w.catchFault("misfill")){
						// A short fill, not a negative one. The shortfall is a
						// flat 30ml, which is fine for a half-and-half recipe
						// but not for a small component: 25% of a 100ml bottle
						// is 25ml, and 25 - 30 asked the plant for -5ml. The
						// plant counts up from zero and its guard is
						// target > 0, so filled was never emitted, the valve
						// stayed open, this station never reported done, and
						// the table barrier - which waits for all four - took
						// the whole line down with it.
						//
						// The clamp keeps the fault a fill the plant can
						// actually finish. Whether 1ml is far enough out to be
						// rejected is then the tolerance check's decision, not
						// this line's.
						ml = ml - 30;
						if(ml < 1){
							ml = 1;
						}
						System.out.println("[FILL] Metering fault on " + w + ".");
					}
					System.out.println("[FILL] Liquid " + w.nextLiquidName() + ", " + ml + "ml into " + w + ".");
					w.started(Machine.FILLER, "liquid " + w.nextLiquidName());
					if(t.update(PlantClock.now(), MachineStatus.WORKING, "valveOpen", ml + "ml")){
						emit twin(t);
					}
					// Both are held for the whole fill. fillTarget used to be a
					// single emit, which the plant can miss entirely - it is
					// on the far side of a link, same as any other signal.
					abort(immediate auto){ await(immediate valveOpenM); }
					abort(immediate filled){
						while(true){
							emit valveOpen;
							emit fillTarget(ml);
							pause;
						}
					}

					w.dispensed(ml);
					if(!w.lastFillInTolerance(asked)){
						System.out.println("[FILL] Out of tolerance: asked " + asked + "ml, metered " + ml + "ml.");
						w.reject(Machine.FILLER, "fill out of tolerance");
					}
					w.completed(Machine.FILLER, "fill complete");
					t.setDispensed(ml, ml / 20);
					if(t.update(PlantClock.now(), MachineStatus.IDLE, "valveShut", ml + "ml dispensed")){
						emit twin(t);
					}
					System.out.println("[FILL] " + w + " now at " + w.filledMl() + "ml.");
				}
		

				send done(w);
			}
		

			pause;
		}
	}
}
