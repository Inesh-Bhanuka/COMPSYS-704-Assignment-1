/*
 * Placeholder workstations for positions 2 to 5 of the rotary table.
 *
 * Each station blocks on a start channel, works for a fixed number of ticks,
 * and sends the identity back on a done channel. The enable/done signal pair
 * and its three-tick acknowledgement padding are gone: a rendezvous cannot be
 * missed, so there is nothing to pad.
 *
 * The durations are deliberately different so the table's barrier is visible:
 * the capper is the slowest, so a finished filler waits for it every cycle.
 *
 * All four live in one clock domain purely to keep the number of processes
 * down during testing. The real Filler, Lid Loader and Capper are separate
 * machines with their own controllers and plants.
 */
StationStubs(
		// from / to the Rotary Table Controller
		input  Integer channel startFiller1, startFiller2, startLid, startCapper;
		output Integer channel doneFiller1, doneFiller2, doneLid, doneCapper;

		// from the System Controller
		input signal enable;
		)
->
{
	{ // ---- Position 2: liquid filler 1 ----
		int FILL = 6;
		int b = 0;
		int t = 0;
		while(true){
			receive startFiller1;
			b = ((Integer)#startFiller1).intValue();
			if(b != 0){ System.out.println("[ST] Filler 1: dispensing into bottle " + b + "."); }
			// Identity 0 means the table's position was empty this cycle,
			// so the station cycles through in no time at all.
			t = (b == 0) ? 0 : FILL;
			while(t > 0){ t--; pause; }
			if(b != 0){ System.out.println("[ST] Filler 1: bottle " + b + " complete."); }
			send doneFiller1(b);
			pause;
		}
	}
	||
	{ // ---- Position 3: liquid filler 2 ----
		int FILL = 8;
		int b = 0;
		int t = 0;
		while(true){
			receive startFiller2;
			b = ((Integer)#startFiller2).intValue();
			if(b != 0){ System.out.println("[ST] Filler 2: dispensing into bottle " + b + "."); }
			// Identity 0 means the table's position was empty this cycle,
			// so the station cycles through in no time at all.
			t = (b == 0) ? 0 : FILL;
			while(t > 0){ t--; pause; }
			if(b != 0){ System.out.println("[ST] Filler 2: bottle " + b + " complete."); }
			send doneFiller2(b);
			pause;
		}
	}
	||
	{ // ---- Position 4: lid placement ----
		int LID = 4;
		int b = 0;
		int t = 0;
		while(true){
			receive startLid;
			b = ((Integer)#startLid).intValue();
			if(b != 0){ System.out.println("[ST] Lid loader: placing lid on bottle " + b + "."); }
			t = (b == 0) ? 0 : LID;
			while(t > 0){ t--; pause; }
			if(b != 0){ System.out.println("[ST] Lid loader: bottle " + b + " complete."); }
			send doneLid(b);
			pause;
		}
	}
	||
	{ // ---- Position 5: capper ----
		int CAP = 12;
		int b = 0;
		int t = 0;
		while(true){
			receive startCapper;
			b = ((Integer)#startCapper).intValue();
			if(b != 0){ System.out.println("[ST] Capper: screwing cap on bottle " + b + "."); }
			t = (b == 0) ? 0 : CAP;
			while(t > 0){ t--; pause; }
			if(b != 0){ System.out.println("[ST] Capper: bottle " + b + " complete."); }
			send doneCapper(b);
			pause;
		}
	}
}
