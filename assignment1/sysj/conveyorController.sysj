/*
 * Controller for the Bottling Station conveyor.
 *
 * Concurrent reactions:
 *   1. advertise infeed readiness to the bottle loader
 *   2. accept bottles from the loader onto the belt
 *   3. run the infeed belt
 *   4. hand off from index position 1 to the table
 *   5. outfeed transport: index position 5 -> labeller collection point
 *
 * Accepting and handing off are separate reactions so that several bottles
 * can be on the infeed at once - one waiting at position 1 for the table
 * while others are still travelling.
 *
 * Each transport boundary uses the same pattern: a readiness level in from
 * downstream, a delivery event out to downstream, and a local arrival sensor.
 * The outfeed currently has no readiness input because the brief allows a
 * collector that is always available; when the labeller can refuse a bottle,
 * add labellerReady and gate the release on it exactly as the infeed gates
 * on tableReady.
 */
ConveyorController(
		// from / to the Bottle Loader
		input  signal bottlePlaced;
		output signal conveyorReady;

		// from the plant
		input signal bottleAtPos1, infeedClear, bottleAtOutfeedEnd, outfeedClear;

		// to the plant
		output signal motInfeed, injectInfeed, takeFromPos1;
		output signal motOutfeed, injectOutfeed, collectFromEnd;

		// from / to the turntable
		input  signal tableReady, bottleFromTable, bottleTaken;
		output signal bottleToTable;

		// to the System Controller / labeller
		output signal bottleAtLabeller;
		)
->
{
	{ // ---- 1. Infeed readiness: the load point is free ----
		while(true){
			present(infeedClear){
				emit conveyorReady;
			}
			pause;
		}
	}
	||
	{ // ---- 2. Accept bottles from the loader onto the belt ----
		while(true){
			await(immediate bottlePlaced);
			System.out.println("[CV] Bottle received from loader.");

			emit injectInfeed; pause;
			emit injectInfeed; pause;
			emit injectInfeed; pause;

			// Wait for the loader's delivery event to clear, so a stale
			// bottlePlaced cannot inject the same bottle twice.
			await(immediate !bottlePlaced);
		}
	}
	||
	{ // ---- 3. Infeed belt runs continuously ----
		//
		// Bottles queue against each other in the plant model, so the motor
		// does not need to be sequenced per bottle. Accepting and handing off
		// are now independent, which is what lets several bottles be in
		// transit at once.
		while(true){
			emit motInfeed;
			pause;
		}
	}
	||
	{ // ---- 4. Hand off from position 1 to the table ----
		while(true){
			await(immediate bottleAtPos1);

			present(tableReady){
				// table can take it straight away
			}
			else {
				System.out.println("[CV] At position 1 - waiting for table.");
				await(immediate tableReady);
			}

			// Hold the offer until the table acknowledges. A timed offer can
			// expire before the table samples it, and the bottle is then lost.
			abort(bottleTaken){
				sustain bottleToTable;
			}

			// Kept short: the table has already acknowledged with bottleTaken,
			// so this only has to be long enough for the plant to sample it.
			emit takeFromPos1; pause;
			emit takeFromPos1; pause;
			System.out.println("[CV] Handed off to table.");
			await(immediate !bottleTaken);
			await(immediate !bottleAtPos1);
		}
	}
	||
	{ // ---- 5. Outfeed transport ----
		while(true){
			await(immediate bottleFromTable);
			System.out.println("[CV] Bottle received from turntable.");

			emit injectOutfeed; pause;
			emit injectOutfeed; pause;
			emit injectOutfeed; pause;

			abort(bottleAtOutfeedEnd){
				sustain motOutfeed;
			}

			System.out.println("[CV] Bottle delivered to labeller point.");

			// Notify downstream, and assume the collector takes it.
			emit bottleAtLabeller; emit collectFromEnd; pause;
			emit bottleAtLabeller; emit collectFromEnd; pause;
			emit bottleAtLabeller; emit collectFromEnd; pause;

			await(immediate !bottleFromTable);
		}
	}
}
