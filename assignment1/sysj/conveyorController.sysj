/*
 * Controller for the Bottling Station conveyor.
 *
 * Reactions:
 *   1. accept bottles from the loader onto the infeed belt
 *   2. run the infeed belt
 *   3. hand off from index position 1 to the rotary table
 *   4. outfeed: take from the table, deliver to the labeller point, report
 *
 * Every machine-to-machine link is a channel. Readiness is no longer
 * advertised as a level: a reaction only reaches its receive when its belt
 * can actually take a bottle, so being at the receive IS the readiness.
 * That deleted conveyorReady, tableReady and bottleTaken outright.
 *
 * Actuator pulses to the plant are sustained until the plant's own sensor
 * confirms the effect, rather than emitted for a fixed number of ticks.
 *
 * BeltQueue carries the identities of the bottles on the infeed. The belt is
 * physically FIFO, so order is all the controller needs to know.
 */
ConveyorController(
		// from the Bottle Loader
		input  WorkpieceTwin channel bottleHandoff;

		// to / from the Rotary Table
		output WorkpieceTwin channel tableInfeed;
		input  WorkpieceTwin channel tableOutfeed;

		// to the System Controller
		output WorkpieceTwin channel bottleDone;

		// the machine's own summary, out to the coordinator
		output ConveyorTwin signal twin;

		// from the plant
		input signal bottleAtPos1, infeedClear, infeedAdmitted;
		input signal bottleAtOutfeedEnd, outfeedClear;

		// to the plant
		output signal motInfeed, injectInfeed, takeFromPos1;
		output signal motOutfeed, injectOutfeed, collectFromEnd;

		// operating mode
		input Integer signal mode;

		// Hard reset: drop whatever is held and go back to idle. One tick,
		// no sequence to finish - the bottle it was working on no longer
		// exists anywhere else either.
		input signal reset;

		// manual overrides - the operator panel attaches here
		input signal motInfeedM, takeFromPos1M, motOutfeedM;
		input signal injectInfeedM, injectOutfeedM, collectFromEndM;
		)
->
{
	signal auto, manual;

	{ // Mode select
		while(true){
			present(mode){
				// 0 automatic, 1 manual, 2 paused. Paused emits neither, so
				// every gate below waits and the operator panel is inert.
				if((Integer)#mode == 0){ emit auto; }
				else if((Integer)#mode == 1){ emit manual; }
			}
			pause;
		}
	}
	||
	{ // Auto
		//
		// All four belt reactions run as one automatic block so that a switch
		// to manual drops every one of them together. Leaving any of them
		// running would fight the operator for the same motor.
		while(true){
			abort(immediate reset){
	{ // ---- 1. Accept from the loader ----
		BeltQueue q = BeltQueue.shared();
		WorkpieceTwin w = null;
		while(true){
			// Only offer to take one when the load point is free. The loader
			// blocks at its send until this reaction reaches the receive.
			await(immediate infeedClear);

			receive bottleHandoff;
			w = (WorkpieceTwin)#bottleHandoff;
			q.push(w);
			System.out.println("[CV] Accepted " + w + " from the loader.");

			// Hold the injection until the plant confirms the bottle is on
			// the belt. Note this acknowledges against infeedAdmitted, not
			// against infeedClear going away: the belt runs continuously, so
			// the bottle is already moving by the time the load point would
			// have read occupied.
			abort(immediate auto){ await(immediate injectInfeedM); }
			abort(immediate infeedAdmitted){
				sustain injectInfeed;
			}
			pause;
		}
	}
	||
	{ // ---- 2. Infeed belt runs continuously ----
		ConveyorTwin t = new ConveyorTwin();
		t.setMoving(true);
		while(true){
			// A level, not a stroke: the belt runs all the time in automatic
			// and only while the operator is asserting it by hand.
			present(auto){ emit motInfeed; }
			present(motInfeedM){ emit motInfeed; }
			if(t.update(PlantClock.now(), MachineStatus.WORKING, "motInfeed", "running")){
				emit twin(t);
			}
			pause;
		}
	}
	||
	{ // ---- 3. Hand off position 1 to the table ----
		BeltQueue q = BeltQueue.shared();
		WorkpieceTwin w = null;
		while(true){
			await(immediate bottleAtPos1);

			w = q.peek();

			// The belt says there is a bottle and the model says there is
			// not. That happens for one cycle after a hard reset, which
			// empties the queue while the belt is still carrying
			// something. Take it off and say nothing to the table: handing
			// it a bottle that does not exist would park its intake
			// waiting for a placement that can never happen.
			if(w == null){
				System.out.println("[CV] Clearing a bottle left on the belt by a reset.");
				abort(immediate auto){ await(immediate takeFromPos1M); }
				abort(immediate !bottleAtPos1){
					sustain takeFromPos1;
				}
			}

			if(w != null){
				w.arrived(Machine.CONVEYOR);
				System.out.println("[CV] " + w + " at position 1, offering to the table.");

				// Blocks until the table's intake reaction takes it
				send tableInfeed(w);
				q.pop();

				// Remove it from the belt, holding the command until the
				// plant confirms position 1 is empty
				abort(immediate auto){ await(immediate takeFromPos1M); }
				abort(immediate !bottleAtPos1){
					sustain takeFromPos1;
				}
				System.out.println("[CV] " + w + " handed to the table.");
			}
			pause;
		}
	}
	||
	{ // ---- 4. Outfeed ----
		WorkpieceTwin w = null;
		while(true){
			await(immediate outfeedClear);

			receive tableOutfeed;
			w = (WorkpieceTwin)#tableOutfeed;

			// Record the belt, not just the machine. Infeed and outfeed are
			// the same conveyor to the plant but opposite ends of the line to
			// anyone watching, and without this a bottle leaving the table
			// still reads as being where it came in.
			if(w != null){ w.started(Machine.CONVEYOR, "outfeed"); }
			System.out.println("[CV] " + w + " received from the table.");

			abort(immediate auto){ await(immediate injectOutfeedM); }
			abort(immediate !outfeedClear){
				sustain injectOutfeed;
			}

			abort(immediate auto){ await(immediate motOutfeedM); }
			abort(bottleAtOutfeedEnd){
				sustain motOutfeed;
			}

			abort(immediate auto){ await(immediate collectFromEndM); }
			abort(immediate !bottleAtOutfeedEnd){
				sustain collectFromEnd;
			}
			System.out.println("[CV] " + w + " delivered to the labeller point.");

			send bottleDone(w);
			pause;
		}
	}
			}
		

			pause;
		}
	}
}
