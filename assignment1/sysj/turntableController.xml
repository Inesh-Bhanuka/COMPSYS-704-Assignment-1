<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS12" Local="true">
		<ClockDomain Name="RotaryTableControllerCD" Class="RotaryTableController">
			<!-- RotaryTableControllerCD listens on 13000 -->

			<!-- from the conveyor (12000) -->
			<iSignal Name="bottleToTable" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />

			<!-- from the plant -->
			<iSignal Name="tableAligned"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos1"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos2"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos4"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos6"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />

			<!-- from the stations -->
			<iSignal Name="fillerDone1"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="fillerDone2"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="lidDone"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="capperDone"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />

			<!-- to the conveyor (12000) -->
			<oSignal Name="tableReady"      To="ConveyorControllerCD.tableReady"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
			<oSignal Name="bottleFromTable" To="ConveyorControllerCD.bottleFromTable" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
			<oSignal Name="bottleTaken"     To="ConveyorControllerCD.bottleTaken"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />

			<!-- to the plant (13001) -->
			<oSignal Name="rotaryTrigger" To="RotaryTablePlantCD.rotaryTrigger" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13001" />
			<oSignal Name="loadPos1"      To="RotaryTablePlantCD.loadPos1"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13001" />
			<oSignal Name="unloadExit"    To="RotaryTablePlantCD.unloadExit"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13001" />

			<!-- to the stations (13003) -->
			<oSignal Name="enableFiller1" To="StationStubsCD.enableFiller1"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13003" />
			<oSignal Name="enableFiller2" To="StationStubsCD.enableFiller2"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13003" />
			<oSignal Name="enableLid"     To="StationStubsCD.enableLid"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13003" />
			<oSignal Name="enableCapper"  To="StationStubsCD.enableCapper"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13003" />
		</ClockDomain>
	</SubSystem>
</System>