<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS9" Local="true">
		<ClockDomain Name="TurntableStubCD" Class="TurntableStub">
			<!-- TurntableStubCD listens on 12003 -->
			<iSignal Name="enable"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />
			<iSignal Name="bottleToTable" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12003" />

			<oSignal Name="tableReady"      To="ConveyorControllerCD.tableReady"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
			<oSignal Name="bottleFromTable" To="ConveyorControllerCD.bottleFromTable" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
		</ClockDomain>
	</SubSystem>
</System>