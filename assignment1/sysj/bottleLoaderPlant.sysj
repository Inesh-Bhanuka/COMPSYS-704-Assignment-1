/*
 * Plant model for the Bottle Loader.
 *
 * Models a pick-and-place arm that lifts empty bottles from a supply point
 * and carries them to the conveyor load point. Fundamentally the same as the LidLoader,
 * with some minor differences
 */
BottleLoaderPlant(
		// from the Bottle Loader Controller
		input signal vacOn, release, armSource, armDest;

		// from the System Controller
		input signal enable;

		// to the Bottle Loader Controller
		output signal bottleAtSource, WPgripped, armAtSource, armAtDest, supplyEmpty;
		)
->
{
	{ // Arm movements between bottle storage and conveyor
		while(true){
			abort(armSource && enable){
				sustain armAtDest;
			}
			abort(armDest && enable){
				sustain armAtSource;
			}
		}
	}
	||
	{ // Gripper and bottle supply
		int supply = 20;
		boolean holding = false;

		while(true){
			present(enable){

				if(holding){
					// Hold bottle till release
					present(release){
						holding = false;
						System.out.println("[BLPlant] Bottle released.");
					}
				}
				else {
					// Pick only when the arm is at the supply, the vacuum is on,
					// and a bottle is actually there
					present(vacOn && armAtSource){
						if(supply > 0){
							supply--;
							holding = true;
							System.out.println("[BLPlant] Bottle picked, supply = " + supply);
						}
						else {
							System.out.println("[BLPlant] Pick attempted but supply is empty.");
						}
					}
				}

				if(holding){
					emit WPgripped;
				}

				if(supply > 0){
					emit bottleAtSource;
				}
				else {
					emit supplyEmpty;
				}
			}
			pause;
		}
	}
}
