SystemController(
		// To BottleLoaderControllerCD
		output Integer signal mode;
		output signal bottleLoad;

		// To the plant models
		output signal enable;    // -> BottleLoaderPlantCD
		output signal enableCV;  // -> ConveyorStubCD

		// From BottleLoaderControllerCD
		input signal bottleLoaded;
		)
->
{
	{ // ---- Operating mode: hold the loader in AUTO (0) ----
		while(true){
			emit mode(0);
			pause;
		}
	}
	||
	{ // ---- Plant power: one enable per machine, since an oSignal has a
	  //      single destination and each plant listens on its own port ----
		while(true){
			emit enable;
			emit enableCV;
			pause;
		}
	}
	||
	{ // ---- Drive a sequence of bottle load cycles ----

		// Let the TCP links between the subsystems settle.
		pause; pause; pause; pause; pause;

		int cycles = 5;
		int i = 0;

		while(i < cycles){
			System.out.println("[SC] Requesting bottle load " + (i + 1) + " of " + cycles + "...");

			abort(bottleLoaded){
				sustain bottleLoad;
			}

			i++;
			System.out.println("[SC] Bottle " + i + " loaded onto conveyor.");

			// Drop the request long enough for bottleLoaded to clear before
			// the next abort arms, otherwise the next cycle terminates
			// instantly on a stale acknowledgement.
			pause; pause; pause;
		}

		System.out.println("[SC] All " + cycles + " bottles loaded.");
		while(true){ pause; }
	}
}
