SystemController(
		// To BottleLoaderControllerCD
		output Integer signal mode;
		output signal bottleLoad;

		// One enable per plant: an oSignal has a single destination
		output signal enableBL;   // -> BottleLoaderPlantCD
		output signal enableCV;   // -> ConveyorPlantCD
		output signal enableTT;   // -> TurntableStubCD

		// From the machines
		input signal bottleLoaded;
		input signal bottleAtLabeller;
		)
->
{
	{ // ---- Operating mode ----
		while(true){
			emit mode(0);
			pause;
		}
	}
	||
	{ // ---- Plant power ----
		while(true){
			emit enableBL;
			emit enableCV;
			emit enableTT;
			pause;
		}
	}
	||
	{ // ---- Drive bottle load cycles ----
		pause; pause; pause; pause; pause;

		int cycles = 4;
		int i = 0;

		while(i < cycles){
			System.out.println("[SC] Requesting bottle load " + (i + 1) + " of " + cycles + "...");

			abort(bottleLoaded){
				sustain bottleLoad;
			}

			i++;
			System.out.println("[SC] Bottle " + i + " loaded onto conveyor.");

			pause; pause; pause;
		}

		System.out.println("[SC] All " + cycles + " load requests issued.");
		while(true){ pause; }
	}
	||
	{ // ---- End of line reporting ----
		int delivered = 0;
		boolean seen = false;

		while(true){
			present(bottleAtLabeller){
				if(!seen){
					delivered++;
					seen = true;
					System.out.println("[SC] Bottle " + delivered + " reached the labeller.");
				}
			}
			else {
				seen = false;
			}
			pause;
		}
	}
}
