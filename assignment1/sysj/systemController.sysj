/*
 * Plant coordinator.
 *
 * Commands and acknowledgements are channels: they are transactions that
 * carry a workpiece identity and must not be lost. Operating mode and plant
 * power stay signals, because they are levels that every reaction tests each
 * tick rather than transfers between two parties.
 *
 * Each channel gets its own reaction. A rendezvous blocks the reaction that
 * performs it, so putting the load orders, the loader's acknowledgements and
 * the end-of-line reports in one sequential reaction would let any one of
 * them stall the others.
 */
SystemController(
		// to / from the Bottle Loader
		output Integer channel loadOrder;
		input  Integer channel loadAck;

		// from the end of the line
		input  Integer channel bottleDone;

		// levels, not transfers
		output Integer signal mode;
		output signal enableBL;   // -> BottleLoaderPlantCD
		output signal enableCV;   // -> ConveyorPlantCD
		output signal enableRT;   // -> RotaryTablePlantCD
		output signal enableST;   // -> StationStubsCD
		)
->
{
	{ // ---- Operating mode ----
		while(true){
			emit mode(0);
			pause;
		}
	}
	||
	{ // ---- Plant power ----
		while(true){
			emit enableBL;
			emit enableCV;
			emit enableRT;
			emit enableST;
			pause;
		}
	}
	||
	{ // ---- Issue load orders ----
		//
		// The send blocks until the loader is actually free to take the next
		// order, so the coordinator needs no artificial spacing between
		// cycles. The bottle number is the workpiece identity from here on.
		pause; pause; pause; pause; pause;

		int cycles = 4;
		int i = 1;

		while(i <= cycles){
			System.out.println("[SC] Order: load bottle " + i + " of " + cycles + ".");
			send loadOrder(i);
			i++;
			pause;
		}

		System.out.println("[SC] All " + cycles + " load orders issued.");
		while(true){ pause; }
	}
	||
	{ // ---- Acknowledgements from the loader ----
		int b = 0;
		while(true){
			receive loadAck;
			b = ((Integer)#loadAck).intValue();
			System.out.println("[SC] Bottle " + b + " is on the conveyor.");
			pause;
		}
	}
	||
	{ // ---- End of line ----
		int delivered = 0;
		int b = 0;
		while(true){
			receive bottleDone;
			b = ((Integer)#bottleDone).intValue();
			delivered++;
			System.out.println("[SC] Bottle " + b + " finished. " + delivered + " complete.");
			pause;
		}
	}
}
