/*
 * Plant coordinator.
 *
 * Takes orders from the POS, turns each into a load command, and reports
 * completions back. Commands and acknowledgements are channels because they
 * carry a workpiece; mode and plant power are signals because they are levels
 * every machine tests each tick.
 *
 * One reaction per channel, so a slow machine cannot stall the others.
 */
SystemController(
		// from / to the POS
		input  Workpiece channel purchaseOrder;
		output Integer  channel orderProgress;

		// to / from the Bottle Loader
		output Workpiece channel loadOrder;
		input  Workpiece channel loadAck;

		// from the end of the line
		input Workpiece channel bottleDone;

		// operating mode, one output per machine controller
		output Integer signal modeBL, modeF1, modeF2, modeLL, modeCP;

		// plant power, one output per plant
		output signal enableBL, enableCV, enableRT;
		output signal enableF1, enableF2, enableLL, enableCP;
		)
->
{
	{ // Operating mode: 0 = auto, 1 = manual
		while(true){
			emit modeBL(0); emit modeF1(0); emit modeF2(0);
			emit modeLL(0); emit modeCP(0);
			pause;
		}
	}
	||
	{ // Plant power
		while(true){
			emit enableBL; emit enableCV; emit enableRT;
			emit enableF1; emit enableF2; emit enableLL; emit enableCP;
			pause;
		}
	}
	||
	{ // Orders in, load commands out
		Workpiece w = null;
		while(true){
			receive purchaseOrder;
			w = (Workpiece)#purchaseOrder;
			System.out.println("[SC] Loading " + w + ".");
			send loadOrder(w);
			pause;
		}
	}
	||
	{ // Loader acknowledgements
		while(true){
			receive loadAck;
			System.out.println("[SC] " + (Workpiece)#loadAck + " is on the conveyor.");
			pause;
		}
	}
	||
	{ // End of line
		Workpiece w = null;
		int done = 0;
		while(true){
			receive bottleDone;
			w = (Workpiece)#bottleDone;
			done++;
			System.out.println("[SC] " + w + " finished at " + w.filledMl() + "ml, sealed=" + w.isSealed() + ". " + done + " complete.");
			send orderProgress(new Integer(w.id));
			pause;
		}
	}
}
