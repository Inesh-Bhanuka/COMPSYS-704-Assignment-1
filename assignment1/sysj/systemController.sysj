/*
 * Plant coordinator.
 *
 * Takes orders from the POS, turns each into a load command, and reports
 * completions back. Commands and acknowledgements are channels because they
 * carry a workpiece; mode and plant power are signals because they are levels
 * every machine tests each tick.
 *
 * One reaction per channel, so a slow machine cannot stall the others.
 *
 * ---- Recycling Station ----
 *
 * The coordinator keeps overall responsibility for the production plan and
 * for the identity of every workpiece, but it does not sequence the internal
 * operations of the recycling process. It delegates the whole recovery of a
 * rejected bottle to the Recycling Station Controller and waits for a single
 * completion notification. Its view of a rejected bottle is only three
 * states: in production, in recycling, and recovered.
 *
 * The quality decision is made on the outfeed, by the splitter, which is
 * where the mechanism that acts on it actually is. The coordinator hands the
 * bottle to the splitter, the splitter reads the record off the twin and
 * drives the diverter it senses, and the route it reports is the route the
 * bottle physically took. The labeller still refuses anything its own history
 * does not justify, so a jammed diverter is caught rather than shipped: two
 * independent mechanisms, not one.
 */
SystemController(
		// from / to the POS
		input PosOrderRequest signal purchaseOrder;
        input GuiCommand signal guiCommand;
        output GuiSnapshot signal guiStatus;
        output GuiPermit signal permitRT, permitF1, permitF2, permitLL, permitCP, permitCV, permitLB, permitRC;
		output PosOrderStatus signal productionStatus;

		// to / from the Bottle Loader
		output WorkpieceTwin channel loadOrder;
		input  WorkpieceTwin channel loadAck;

		// from the end of the line
		input WorkpieceTwin channel bottleDone;

		// to / from the quality splitter, which sits on the outfeed ahead of
		// the labeller and routes the bottle physically
		output WorkpieceTwin channel toSplitter;
		input  Integer channel splitterRoute;

		// to / from the Labeller
		output WorkpieceTwin channel labelBottle;
		input  WorkpieceTwin channel labelDone;

		// machine twins in, one per subsystem controller. Each machine writes
		// its own; the coordinator only collects them.
		input LoaderTwin      signal twinBL;
		input ConveyorTwin    signal twinCV;
		input RotaryTableTwin signal twinRT;
		input FillerTwin      signal twinF1;
		input FillerTwin      signal twinF2;
		input LidLoaderTwin   signal twinLL;
		input LidCapperTwin   signal twinCP;
		input LabellerTwin    signal twinLB;
		input Integer         signal labellerStatus;

		// to / from the Recycling Station Controller
		output WorkpieceTwin channel bottleRejected;
		input  WorkpieceTwin channel bottleRecycled;
		input  Integer signal recyclingStatus;

		// operating mode, one output per machine controller
		output Integer signal modeBL, modeF1, modeF2, modeLL, modeCP, modeLB;
		output Integer signal modeSP, modeRC, modeLR, modeLD, modeBR;

		// plant power, one output per plant
		output signal enableBL, enableCV, enableRT;
		output signal enableF1, enableF2, enableLL, enableCP, enableLB;
		output signal enableSP, enableRC, enableLR, enableLD, enableBR;
		)
->
{
	{ // Operating mode: 0 = auto, 1 = manual
		while(true){
			emit modeBL(0); emit modeF1(0); emit modeF2(0);
			emit modeLL(0); emit modeCP(0); emit modeLB(0);
			emit modeSP(0); emit modeRC(0); emit modeLR(0);
			emit modeLD(0); emit modeBR(0);
			pause;
		}
	}
	||
	{ // Plant power
		while(true){
			emit enableBL; emit enableCV; emit enableRT;
			emit enableF1; emit enableF2; emit enableLL; emit enableCP; emit enableLB;
			emit enableSP; emit enableRC; emit enableLR;
			emit enableLD; emit enableBR;
			pause;
		}
	}
	||
	{ // Complete purchase orders and persistent status feedback
        GuiPermit permits = null;
        PosOrderStatus feedback = null;
        while(true){
            present(guiCommand){ GuiSupervisor.command((GuiCommand)#guiCommand); }
            permits = GuiSupervisor.permits();
            emit permitRT(permits); emit permitF1(permits); emit permitF2(permits);
            emit permitLL(permits); emit permitCP(permits); emit permitCV(permits);
            emit permitLB(permits); emit permitRC(permits);
            present(purchaseOrder){ OrderBook.accept((PosOrderRequest)#purchaseOrder); }
            feedback = OrderBook.feedback();
            if(feedback != null){ emit productionStatus(feedback); }
            pause;
        }
    }
    ||
    { // Batch scheduling
		WorkpieceTwin w = null;
		while(true){
			w = null;
            if(GuiSupervisor.canLoad()){ w = OrderBook.nextBottle(); }
            if(w != null){
			System.out.println("[SC] Loading " + w + ".");
			TwinRegistry.shared().admit(w);
			send loadOrder(w);
            }
			pause;
		}
	}
	||
	{ // Loader acknowledgements
		while(true){
			receive loadAck;
			System.out.println("[SC] " + (WorkpieceTwin)#loadAck + " is on the conveyor.");
			pause;
		}
	}
	||
	{ // End of line: the splitter routes, the labeller is the backstop
		//
		// One reaction owns the whole tail of the line, because there is
		// exactly one sender on bottleRejected and a bottle can reach it two
		// ways: diverted by the splitter, or refused by the labeller after a
		// diverter fault let it through. The outfeed carries one bottle at a
		// time, so there is nothing here to overlap anyway.
		int DIVERTED = 1;

		WorkpieceTwin w = null;
		int route = 0;
		boolean divert = false;
		int done = 0;

		while(true){
			receive bottleDone;
			w = (WorkpieceTwin)#bottleDone;
			while(!GuiSupervisor.qualityAllowed()){ pause; }

			// The splitter reads the quality record and throws the diverter.
			// What comes back is the route the bottle actually took, not the
			// route that was asked for.
			send toSplitter(w);
			receive splitterRoute;
			route = ((Integer)#splitterRoute).intValue();
			divert = (route == DIVERTED);
			pause;

			// Anything still on the normal path goes to the labeller, which
			// checks it against its own history. A refusal here is the
			// backstop for a diverter that did not throw.
			if(!divert){
				send labelBottle(w);
				receive labelDone;
				w = (WorkpieceTwin)#labelDone;
				divert = w.isRejected();
			}
			pause;

			if(divert){
				System.out.println("[SC] " + w + " goes to the Recycling Station (" + w.defect() + ").");
				send bottleRejected(w);
			}

			if(!divert){
				// The outfeed sets it down in the storage for its batch, which
				// is where the line ends. The twin retires with it.
				w.arrived(Machine.BATCH_STORAGE);
				w.seal();
				BatchStore.shared().store(w);
				done++;
				System.out.println("[SC] " + w + " labelled " + w.serial + " and stored in batch "
						+ w.batchId + " (" + BatchStore.shared().held(w.batchId) + " on the shelf). "
						+ done + " complete.");
				OrderBook.delivered(w);
			}
			pause;
		}
	}
	||
	{ // The plant twin
		//
		// One writer, one job: collect the machine twins as they arrive,
		// track every workpiece admitted, advance the plant clock and publish
		// the whole thing. A complete snapshot every tick rather than a
		// differential, so a display that misses one is a tick behind rather
		// than out of step.
		ABSTwin plant = new ABSTwin();
		TwinPublisher out = TwinPublisher.shared();
        GuiSnapshot guiSnapshot = null;

		// Hold every clock domain to a watchable rate. Done from here rather
		// than from a launcher because the program can be started several
		// ways - the GUI launcher, the runtime's own main, a test harness -
		// and the System Controller is in all of them.
		PlantPace.install();

		while(true){
			PlantClock.advance();

			present(twinBL){ plant.put((LoaderTwin)#twinBL); }
			present(twinCV){ plant.put((ConveyorTwin)#twinCV); }
			present(twinRT){ plant.put((RotaryTableTwin)#twinRT); }
			present(twinF1){ plant.put((FillerTwin)#twinF1); GuiTelemetry.noteMachine("FILLER1", (FillerTwin)#twinF1); }
			present(twinF2){ plant.put((FillerTwin)#twinF2); GuiTelemetry.noteMachine("FILLER2", (FillerTwin)#twinF2); }
			present(twinLL){ plant.put((LidLoaderTwin)#twinLL); }
			present(twinCP){ plant.put((LidCapperTwin)#twinCP); }
			present(twinLB){ plant.put((LabellerTwin)#twinLB); }

			plant.setTick(PlantClock.now());
			plant.setMode(LineMode.AUTO);
			TwinRegistry.shared().fill(plant);
			out.publish(plant, OrderBook.purchaseOrder());
            GuiSupervisor.observe(plant);
            guiSnapshot = GuiTelemetry.capture(plant);
            if(guiSnapshot != null){ emit guiStatus(guiSnapshot); }
			pause;
		}
	}
	||
	{ // Recovered bottles
		//
		// The transaction bottleRejected opened closes here. The POS is told
		// the order line failed and the container was reclaimed, so its
		// accounting stays honest - one order in, no bottle out, one
		// container back in circulation.
		WorkpieceTwin w = null;
		int recovered = 0;
		while(true){
			receive bottleRecycled;
			w = (WorkpieceTwin)#bottleRecycled;
			recovered++;
			System.out.println("[SC] " + w + " recovered by the Recycling Station at "
					+ w.filledMl() + "ml, sealed=" + w.isSealed() + ". " + recovered + " recycled.");
			OrderBook.recycled(w);
			pause;
		}
	}
	||
	{ // Labeller status
		//
		// A level like the recycling station's, sampled every tick and
		// reported only when it changes.
		int last = -1;
		int v = 0;
		while(true){
			present(labellerStatus){
				v = ((Integer)#labellerStatus).intValue();
				if(v != last){
					if(v == 0){ System.out.println("[SC] Labeller: idle."); }
					if(v == 1){ System.out.println("[SC] Labeller: printing."); }
					if(v == 2){ System.out.println("[SC] Labeller: FAULT."); }
					if(v == 3){ System.out.println("[SC] Labeller: refusing - record not justified."); }
					last = v;
				}
			}
			pause;
		}
	}
	||
	{ // Recycling Station status
		//
		// A level, sampled every tick and reported only when it changes.
		int last = -1;
		int v = 0;
		while(true){
			present(recyclingStatus){
				v = ((Integer)#recyclingStatus).intValue();
				if(v != last){
					if(v == 0){ System.out.println("[SC] Recycling Station: idle."); }
					if(v == 1){ System.out.println("[SC] Recycling Station: busy."); }
					if(v == 2){ System.out.println("[SC] Recycling Station: FAULT - no further rejects accepted."); }
					if(v == 3){ System.out.println("[SC] Recycling Station: running, bin or tank near capacity."); }
					last = v;
				}
			}
			pause;
		}
	}
}
