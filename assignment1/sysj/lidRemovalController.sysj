/*
 * Lid Removal Controller.
 *
 * Deliberately the inverse of the ABS capper, and it reuses that machine's
 * signal structure so the two are recognisably related. One cycle is:
 *
 *   1. lower the head onto the bottle    cylZaxisExtend     -> zAxisLowered
 *   2. grip the cap                      lidGripperExtend   -> lidGripped
 *   3. untwist                           unscrewTurnExtend  -> turnAtFinalPos
 *   4. lift clear, carrying the cap      (release)          -> zAxisLifted
 *   5. reset the rotary cylinder         unscrewTurnRetract -> turnAtHomePos
 *   6. drop the cap in the waste bin     lidEjectExtend     -> !lidGripped
 *
 * The workpiece is stripped as well as the plant driven: removeLid() clears
 * the lidded and capped flags the lid loader and capper set, so a recovered
 * bottle really is an unsealed container rather than a sealed one with a flag
 * on it.
 *
 */
LidRemovalController(
		// from / to the Recycling Station Controller
		input  WorkpieceTwin channel enable;
		output Integer channel status;

		// operating mode
		input Integer signal mode;

		// Hard reset: drop whatever is held and go back to idle. One tick,
		// no sequence to finish - the bottle it was working on no longer
		// exists anywhere else either.
		input signal reset;

		// from the Unscrew Arm, Lid Disposal Plant
		input signal zAxisLowered, zAxisLifted, turnAtHomePos, turnAtFinalPos;
		input signal lidGripped, lidBinFull;

		// to the Unscrew Arm, Lid Disposal Plant
		output signal cylZaxisExtend, unscrewTurnExtend, unscrewTurnRetract;
		output signal lidGripperExtend, lidEjectExtend;

		// manual overrides - the operator panel attaches here
		input signal cylZaxisExtendM, unscrewTurnExtendM, unscrewTurnRetractM;
		input signal lidGripperExtendM, lidEjectExtendM;
		)
->
{
	signal auto, manual;

	{ // Mode select
		while(true){
			present(mode){
				// 0 automatic, 1 manual, 2 paused. Paused emits neither, so
				// every gate below waits and the operator panel is inert.
				if((Integer)#mode == 0){ emit auto; }
				else if((Integer)#mode == 1){ emit manual; }
			}
			pause;
		}
	}
	||
	{ // Auto
		int OK = 0;
		int BLOCKED = 2;

		WorkpieceTwin w = null;
		int code = 0;

		while(true){
			abort(immediate reset){
				receive enable;
				w = (WorkpieceTwin)#enable;

				// The station is handed whatever workpiece the RSC is recovering.
				// A null carries no work, so the cycle below is skipped and the
				// status goes back straight away: the sequencer's receive always
				// completes and it is never left waiting on an empty stop.
				code = OK;

				if(w != null){
					System.out.println("[LR] Removing the lid from " + w + ".");

					// 1. lower the head
					abort(immediate auto){ await(immediate cylZaxisExtendM); }
					abort(immediate zAxisLowered){
						sustain cylZaxisExtend;
					}

					// 2. close the gripper on the cap, head held down
					abort(immediate lidGripped){
						abort(immediate auto){ await(immediate lidGripperExtendM); }
						{ sustain cylZaxisExtend; } || { sustain lidGripperExtend; }
					}
					System.out.println("[LR] Cap gripped on " + w + ".");

					// 3. untwist, head still held down
					abort(immediate turnAtFinalPos){
						abort(immediate auto){ await(immediate unscrewTurnExtendM); }
						{ sustain cylZaxisExtend; } || { sustain unscrewTurnExtend; }
					}

					// 4. release the z axis; the head lifts and carries the cap
					//    clear. The gripper has latched onto the cap, so nothing
					//    needs to be held here.
					await(immediate zAxisLifted);

					// 5. reset the rotary cylinder for the next bottle
					abort(immediate auto){ await(immediate unscrewTurnRetractM); }
					abort(immediate turnAtHomePos){
						sustain unscrewTurnRetract;
					}

					// 6. eject into the waste bin, confirmed by the grip letting go
					abort(immediate auto){ await(immediate lidEjectExtendM); }
					abort(immediate !lidGripped){
						sustain lidEjectExtend;
					}

					// The container is now unsealed, on the workpiece as well as
					// in the plant.
					w.removeLid();
					System.out.println("[LR] Lid off " + w + ", sealed=" + w.isSealed() + ".");

					// Back-pressure, evaluated now that the bin holds one more lid.
					code = OK;
					present(lidBinFull){
						System.out.println("[LR] Lid waste bin is full; no further bottles until it is serviced.");
						code = BLOCKED;
	                    // Do not acknowledge readiness until safe servicing clears the sensor.
	                    await(immediate !lidBinFull);
	                    code = OK;
					}
				}

				send status(new Integer(code));
			}
		

			pause;
		}
	}
}
