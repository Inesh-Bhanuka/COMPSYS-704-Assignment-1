<?xml version="1.0" encoding="UTF-8"?>
<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="ABS" Local="true">

		<ClockDomain Name="BottleLoaderPlantCD" Class="BottleLoaderPlant">
			<iSignal Name="vacOn"           Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11001" />
			<iSignal Name="release"         Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11001" />
			<iSignal Name="armSource"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11001" />
			<iSignal Name="armDest"         Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11001" />
			<iSignal Name="enable"          Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11001" />
			<oSignal Name="bottleAtSource"  To="BottleLoaderControllerCD.bottleAtSource" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
			<oSignal Name="WPgripped"       To="BottleLoaderControllerCD.WPgripped" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
			<oSignal Name="armAtSource"     To="BottleLoaderControllerCD.armAtSource" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
			<oSignal Name="armAtDest"       To="BottleLoaderControllerCD.armAtDest" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
			<oSignal Name="supplyEmpty"     To="BottleLoaderControllerCD.supplyEmpty" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
		</ClockDomain>

		<ClockDomain Name="BottleLoaderControllerCD" Class="BottleLoaderController">
			<iChannel Name="loadOrder"    From="SystemControllerCD.loadOrder" />
			<oChannel Name="loadAck"      To="SystemControllerCD.loadAck" />
			<oChannel Name="bottleHandoff" To="ConveyorControllerCD.bottleHandoff" />

			<iSignal Name="mode"            Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="bottleAtSource"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="WPgripped"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="armAtSource"     Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="armAtDest"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="supplyEmpty"     Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="vacOnM"          Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="armSourceM"      Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<iSignal Name="armDestM"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="11000" />
			<oSignal Name="vacOn"           To="BottleLoaderPlantCD.vacOn"         Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
			<oSignal Name="release"         To="BottleLoaderPlantCD.release"       Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
			<oSignal Name="armSource"       To="BottleLoaderPlantCD.armSource"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
			<oSignal Name="armDest"         To="BottleLoaderPlantCD.armDest"       Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
		</ClockDomain>

		<ClockDomain Name="ConveyorPlantCD" Class="ConveyorPlant">
			<iSignal Name="enable"          Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12001" />
			<iSignal Name="motInfeed"       Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12001" />
			<iSignal Name="injectInfeed"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12001" />
			<iSignal Name="takeFromPos1"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12001" />
			<iSignal Name="motOutfeed"      Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12001" />
			<iSignal Name="injectOutfeed"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12001" />
			<iSignal Name="collectFromEnd"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12001" />
			<oSignal Name="bottleAtPos1"    To="ConveyorControllerCD.bottleAtPos1" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
			<oSignal Name="infeedClear"     To="ConveyorControllerCD.infeedClear"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
			<oSignal Name="infeedAdmitted"  To="ConveyorControllerCD.infeedAdmitted" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
			<oSignal Name="bottleAtOutfeedEnd" To="ConveyorControllerCD.bottleAtOutfeedEnd" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
			<oSignal Name="outfeedClear"    To="ConveyorControllerCD.outfeedClear" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12000" />
		</ClockDomain>

		<ClockDomain Name="ConveyorControllerCD" Class="ConveyorController">
			<iChannel Name="bottleHandoff" From="BottleLoaderControllerCD.bottleHandoff" />
			<iChannel Name="tableOutfeed" From="RotaryTableControllerCD.tableOutfeed" />
			<oChannel Name="tableInfeed"  To="RotaryTableControllerCD.tableInfeed" />
			<oChannel Name="bottleDone"   To="SystemControllerCD.bottleDone" />

			<iSignal Name="bottleAtPos1"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="infeedClear"     Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="infeedAdmitted"  Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="bottleAtOutfeedEnd" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<iSignal Name="outfeedClear"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="12000" />
			<oSignal Name="motInfeed"       To="ConveyorPlantCD.motInfeed"         Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="injectInfeed"    To="ConveyorPlantCD.injectInfeed"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="takeFromPos1"    To="ConveyorPlantCD.takeFromPos1"      Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="motOutfeed"      To="ConveyorPlantCD.motOutfeed"        Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="injectOutfeed"   To="ConveyorPlantCD.injectOutfeed"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="collectFromEnd"  To="ConveyorPlantCD.collectFromEnd"    Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
		</ClockDomain>

		<ClockDomain Name="RotaryTablePlantCD" Class="RotaryTablePlant">
			<iSignal Name="enable"          Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13001" />
			<iSignal Name="rotaryTrigger"   Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13001" />
			<iSignal Name="loadPos1"        Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13001" />
			<iSignal Name="unloadExit"      Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13001" />
			<oSignal Name="tableAligned"    To="RotaryTableControllerCD.tableAligned" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="bottleAtPos1"    To="RotaryTableControllerCD.bottleAtPos1" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="bottleAtPos2"    To="RotaryTableControllerCD.bottleAtPos2" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="bottleAtPos4"    To="RotaryTableControllerCD.bottleAtPos4" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="bottleAtPos5"    To="RotaryTableControllerCD.bottleAtPos5" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
			<oSignal Name="exitCleared"     To="RotaryTableControllerCD.exitCleared" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13000" />
		</ClockDomain>

		<ClockDomain Name="RotaryTableControllerCD" Class="RotaryTableController">
			<iChannel Name="tableInfeed"  From="ConveyorControllerCD.tableInfeed" />
			<iChannel Name="doneFiller1"  From="StationStubsCD.doneFiller1" />
			<iChannel Name="doneFiller2"  From="StationStubsCD.doneFiller2" />
			<iChannel Name="doneLid"      From="StationStubsCD.doneLid" />
			<iChannel Name="doneCapper"   From="StationStubsCD.doneCapper" />
			<oChannel Name="tableOutfeed" To="ConveyorControllerCD.tableOutfeed" />
			<oChannel Name="startFiller1" To="StationStubsCD.startFiller1" />
			<oChannel Name="startFiller2" To="StationStubsCD.startFiller2" />
			<oChannel Name="startLid"     To="StationStubsCD.startLid" />
			<oChannel Name="startCapper"  To="StationStubsCD.startCapper" />

			<iSignal Name="tableAligned"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos1"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos2"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos4"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="bottleAtPos5"    Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<iSignal Name="exitCleared"     Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13000" />
			<oSignal Name="rotaryTrigger"   To="RotaryTablePlantCD.rotaryTrigger"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13001" />
			<oSignal Name="loadPos1"        To="RotaryTablePlantCD.loadPos1"       Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13001" />
			<oSignal Name="unloadExit"      To="RotaryTablePlantCD.unloadExit"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13001" />
		</ClockDomain>

		<ClockDomain Name="StationStubsCD" Class="StationStubs">
			<iChannel Name="startFiller1" From="RotaryTableControllerCD.startFiller1" />
			<iChannel Name="startFiller2" From="RotaryTableControllerCD.startFiller2" />
			<iChannel Name="startLid"     From="RotaryTableControllerCD.startLid" />
			<iChannel Name="startCapper"  From="RotaryTableControllerCD.startCapper" />
			<oChannel Name="doneFiller1"  To="RotaryTableControllerCD.doneFiller1" />
			<oChannel Name="doneFiller2"  To="RotaryTableControllerCD.doneFiller2" />
			<oChannel Name="doneLid"      To="RotaryTableControllerCD.doneLid" />
			<oChannel Name="doneCapper"   To="RotaryTableControllerCD.doneCapper" />

			<iSignal Name="enable"          Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="13003" />
		</ClockDomain>

		<ClockDomain Name="SystemControllerCD" Class="SystemController">
			<iChannel Name="loadAck"      From="BottleLoaderControllerCD.loadAck" />
			<iChannel Name="bottleDone"   From="ConveyorControllerCD.bottleDone" />
			<oChannel Name="loadOrder"    To="BottleLoaderControllerCD.loadOrder" />

			<oSignal Name="mode"            To="BottleLoaderControllerCD.mode"     Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11000" />
			<oSignal Name="enableBL"        To="BottleLoaderPlantCD.enable"        Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="11001" />
			<oSignal Name="enableCV"        To="ConveyorPlantCD.enable"            Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="12001" />
			<oSignal Name="enableRT"        To="RotaryTablePlantCD.enable"         Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13001" />
			<oSignal Name="enableST"        To="StationStubsCD.enable"             Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="13003" />
		</ClockDomain>

	</SubSystem>
</System>
