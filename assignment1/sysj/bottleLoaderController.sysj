/*
 * Controller for the Bottle Loader.
 *
 * Coordination is by channel: an order arrives from the coordinator carrying
 * the workpiece identity, the bottle is handed to the conveyor by rendezvous,
 * and an acknowledgement goes back. The old conveyorReady level is gone -
 * readiness is now expressed by the conveyor being at its receive, so the
 * loader simply blocks at the send until the belt can take the bottle.
 *
 * One behavioural change comes with that. The loader used to check the
 * conveyor before starting a cycle and again at the release point. A channel
 * cannot be tested without committing to it, so the arm now picks the bottle,
 * carries it over, and waits there holding it. That is the more faithful
 * behaviour anyway - the bottle leaves the magazine once, not twice.
 */
BottleLoaderController(
		// from / to the System Controller
		input  WorkpieceTwin channel loadOrder;
		output WorkpieceTwin channel loadAck;

		// to the conveyor
		output WorkpieceTwin channel bottleHandoff;

		// the machine's own summary, out to the coordinator
		output LoaderTwin signal twin;

		// operating mode is a level, so it stays a signal
		input Integer signal mode;

		// from the plant
		input signal bottleAtSource, WPgripped, armAtSource, armAtDest, supplyEmpty;

		// to the plant
		output signal vacOn, release, armSource, armDest;

		// manual overrides
		input signal vacOnM, armSourceM, armDestM;
		)
->
{
	signal auto, manual;

	{ // Mode select
		while(true){
			present(mode){
				if((Integer)#mode == 0){
					emit auto;
				}
				else {
					emit manual;
				}
			}
			pause;
		}
	}
	||
	{ // Auto mode
		LoaderTwin t = new LoaderTwin();
		int remaining = 20;
		WorkpieceTwin w = null;

		while(true){
			await(immediate auto);

			abort(immediate manual){

				receive loadOrder;
				w = (WorkpieceTwin)#loadOrder;
				System.out.println("[BL] Order received for " + w + ".");
				w.arrived(Machine.LOADER);
				w.started(Machine.LOADER, "pick and place");
				if(t.update(PlantClock.now(), MachineStatus.WORKING, "load", "order " + w.id)){
					emit twin(t);
				}

				present(bottleAtSource){
					// a bottle is waiting
				}
				else {
					System.out.println("[BL] Warning: no bottle at source.");
				}

				// Go to bottle storage
				abort(armAtSource){
					sustain armSource;
				}

				// Pick up bottle
				abort(WPgripped){
					sustain vacOn;
				}
				System.out.println("[BL] " + w + " gripped.");

				// Move bottle to conveyor
				abort(armAtDest){
					sustain armDest;
				}

				// Offer it. Blocks until the conveyor takes it.
				System.out.println("[BL] Offering " + w + " to the conveyor.");
				send bottleHandoff(w);

				// Release, holding the actuator until the plant confirms it
				// let go. No fixed pulse width.
				abort(immediate !WPgripped){
					sustain release;
				}

				w.completed(Machine.LOADER, "placed on conveyor");
				remaining--;
				t.setBottlesRemaining(remaining);
				if(t.update(PlantClock.now(), MachineStatus.IDLE, "idle", "loaded " + w.id)){
					emit twin(t);
				}
				send loadAck(w);
			}
			pause;
		}
	}
	||
	{ // Manual mode
		while(true){
			await(immediate manual);
			abort(immediate auto){
				while(true){
					present(vacOnM){ emit vacOn; }
					present(armSourceM){ emit armSource; }
					present(armDestM){ emit armDest; }
					pause;
				}
			}
			pause;
		}
	}
	||
	{ // Bottle supply monitoring
		boolean reported = false;
		while(true){
			present(supplyEmpty){
				if(!reported){
					System.out.println("[BL] Bottle supply is empty.");
					reported = true;
				}
			}
			else {
				reported = false;
			}
			pause;
		}
	}
}
