/*
 * Controller for the Bottle Loader.
 *
 * Coordination is by channel: an order arrives from the coordinator, 
 * the bottle is handed to the conveyor by rendezvous,
 * and an acknowledgement goes back. 
 *
 */
BottleLoaderController(
		// from / to the System Controller
		input  WorkpieceTwin channel loadOrder;
		output WorkpieceTwin channel loadAck;

		// to the conveyor
		output WorkpieceTwin channel bottleHandoff;

		// the machine's own summary, out to the coordinator
		output LoaderTwin signal twin;

		// operating mode is a level, so it is a signal rather than a channel
		input Integer signal mode;

		// Hard reset: drop whatever is held and go back to idle. One tick,
		// no sequence to finish - the bottle it was working on no longer
		// exists anywhere else either.
		input signal reset;

		// from the plant
		input signal bottleAtSource, WPgripped, armAtSource, armAtDest, supplyEmpty;

		// to the plant
		output signal vacOn, release, armSource, armDest;

		// manual overrides
		input signal vacOnM, releaseM, armSourceM, armDestM;
		)
->
{
	signal auto, manual;

	{ // Mode select
		while(true){
			present(mode){
			// 0 automatic, 1 manual, 2 paused. Paused emits neither, so
			// every gate below waits and the operator panel is inert.
			if((Integer)#mode == 0){
				emit auto;
			}
			else if((Integer)#mode == 1){
				emit manual;
			}
			}
			pause;
		}
	}
	||
	{ // Auto mode
		LoaderTwin t = new LoaderTwin();
		int remaining = 20;
		WorkpieceTwin w = null;

		while(true){
			abort(immediate reset){

				receive loadOrder;
				w = (WorkpieceTwin)#loadOrder;
				System.out.println("[BL] Order received for " + w + ".");
				w.arrived(Machine.LOADER);
				w.started(Machine.LOADER, "pick and place");
				if(t.update(PlantClock.now(), MachineStatus.WORKING, "load", "order " + w.id)){
					emit twin(t);
				}

				present(bottleAtSource){
					// a bottle is waiting
				}
				else {
					System.out.println("[BL] Warning: no bottle at source.");
				}

				// Go to bottle storage
				abort(immediate auto){ await(immediate armSourceM); }
				abort(armAtSource){
					sustain armSource;
				}

				// Pick up bottle
				abort(immediate auto){ await(immediate vacOnM); }
				abort(WPgripped){
					sustain vacOn;
				}
				System.out.println("[BL] " + w + " gripped.");

				// Move bottle to conveyor
				abort(immediate auto){ await(immediate armDestM); }
				abort(armAtDest){
					sustain armDest;
				}

				// Offer it. Blocks until the conveyor takes it.
				System.out.println("[BL] Offering " + w + " to the conveyor.");
				send bottleHandoff(w);

				// Release, holding the actuator until the plant confirms the
				// bottle has let go. No fixed pulse width.
				abort(immediate auto){ await(immediate releaseM); }
				abort(immediate !WPgripped){
					sustain release;
				}

				w.completed(Machine.LOADER, "placed on conveyor");
				remaining--;
				t.setBottlesRemaining(remaining);
				if(t.update(PlantClock.now(), MachineStatus.IDLE, "idle", "loaded " + w.id)){
					emit twin(t);
				}
				send loadAck(w);
			}
			pause;
		}
	}
	||
	{ // Bottle supply monitoring
		boolean reported = false;
		while(true){
			present(supplyEmpty){
			if(!reported){
				System.out.println("[BL] Bottle supply is empty.");
				reported = true;
			}
			}
			else {
			reported = false;
			}
			pause;
		}
	}
}
