/*
 * Labeller. The last machine on the line, and the one that puts the workpiece
 * twin onto the product.
 *
 * It receives a bottle as its twin rather than as a bare trigger, which is
 * what lets it refuse. A label is evidence of what the plant did, so the
 * content is rendered from the history - the proportions printed are the ones
 * actually metered, not the ones the recipe asked for - and a bottle whose
 * history does not justify a label does not get one. That gives a testable
 * invariant: nothing leaves the ABS carrying a label its own record cannot
 * support.
 */
LabellerController(
		// from / to the System Controller
		input  WorkpieceTwin channel labelBottle;
		output WorkpieceTwin channel labelDone;

		// operating mode
		input Integer signal mode;

		// Hard reset: drop whatever is held and go back to idle. One tick,
		// no sequence to finish - the bottle it was working on no longer
		// exists anywhere else either.
		input signal reset;

		// to the plant
		output LabelData signal printLabel;
		output signal applyLabelExtend, applyLabelRetract, rollerOnOff;

		// from the plant
		input signal bottleAtLabeller, labelPrinted, labelApplied, labelStockLow, glueLow;
		input Integer signal labelStock, glueLevel;

		// the machine's own summary, out to the coordinator
		output LabellerTwin signal twin;

		// to the System Controller
		output Integer signal status;

		// manual override - the operator panel attaches here
		input signal applyLabelExtendM, applyLabelRetractM, rollerOnOffM;
		)
->
{
	signal auto, manual;

	{ // Mode select
		while(true){
			present(mode){
				// 0 automatic, 1 manual, 2 paused. Paused emits neither, so
				// every gate below waits and the operator panel is inert.
				if((Integer)#mode == 0){ emit auto; }
				else if((Integer)#mode == 1){ emit manual; }
			}
			pause;
		}
	}
	||
	{ // Auto
		LabellerTwin t = new LabellerTwin();
		WorkpieceTwin w = null;
		LabelData label = null;
		String refusal = null;

		while(true){
			abort(immediate reset){
				receive labelBottle;
				w = (WorkpieceTwin)#labelBottle;

				if(w != null){
					w.arrived(Machine.LABELLER);

					// Injected fault: the printer produced nothing legible.
					// Flagged before the record is judged, so the refusal
					// below reports the print failure rather than a mystery.
					if(w.catchFault("no-print")){
						System.out.println("[LAB] Print failed for " + w + ".");
						w.reject(Machine.LABELLER, "label did not print");
					}
					refusal = w.labelRefusalReason();

					if(refusal != null){
						// The record does not support a label, so do not print one.
						System.out.println("[LAB] Refusing " + w + ": " + refusal);
						w.reject(Machine.LABELLER, "label refused - " + refusal);
						if(t.update(PlantClock.now(), MachineStatus.FAULT, "refuse", refusal)){
							emit twin(t);
						}
						emit status(2);
					}
					else {
						w.started(Machine.LABELLER, "labelling");
						label = new LabelData(w);
						if(t.update(PlantClock.now(), MachineStatus.WORKING, "printLabel", label.serial)){
							emit twin(t);
						}

						// Print, then apply, then let go.
						//
						// Three strokes, three gates. The glue roller runs with both the
						// print and the application, so it is the roller the operator
						// ticks to start printing.
						abort(immediate auto){ await(immediate rollerOnOffM); }
						abort(immediate labelPrinted){
							while(true){
								emit printLabel(label);
								emit rollerOnOff;
								pause;
							}
						}

						// Load-bearing, not padding. The compiler splits the generated
						// state machine at every pause, and with the three gates added
						// the print and apply halves no longer fit in one method under
						// the JVM's 64 KB limit. It costs one tick between the label
						// printing and the applicator going out.
						pause;

						abort(immediate auto){ await(immediate applyLabelExtendM); }
						abort(immediate labelApplied){
							while(true){
								emit applyLabelExtend;
								emit rollerOnOff;
								pause;
							}
						}

						abort(immediate auto){ await(immediate applyLabelRetractM); }
						emit applyLabelRetract;

						w.completed(Machine.LABELLER, "label " + label.serial);
						t.setLastSerial(label.serial);
						System.out.println("[LAB] Labelled " + w + " as " + label.serial + ", mix " + label.actualPctOne + "/" + label.actualPctTwo + ".");
						if(t.update(PlantClock.now(), MachineStatus.IDLE, "retract", label.serial)){
							emit twin(t);
						}
						emit status(0);
					}
				}

				send labelDone(w);
			}
		

			pause;
		}
	}
	||
	{ // Consumables, reported through the twin
		//
		// labelStockLow and glueLow are levels, not events: once the stock is
		// down they are present on every tick for the rest of the run. Both
		// warnings are therefore reported on the transition only, the same
		// way the bottle loader reports an empty supply. Printed on the level
		// this reaction emitted a quarter of a million identical lines in a
		// single run and buried everything else in the log.
		LabellerTwin t = new LabellerTwin();
		int labels = 0;
		int glue = 0;
		boolean labelsReported = false;
		boolean glueReported = false;

		while(true){
			present(labelStock){ labels = (Integer)#labelStock; }
			present(glueLevel){ glue = (Integer)#glueLevel; }

			present(labelStockLow){
				if(!labelsReported){
					System.out.println("[LAB] Label stock low: " + labels + " left.");
					labelsReported = true;
				}
			}
			else {
				labelsReported = false;
			}

			present(glueLow){
				if(!glueReported){
					System.out.println("[LAB] Glue low: " + glue + " left.");
					glueReported = true;
				}
			}
			else {
				glueReported = false;
			}
			pause;
		}
	}
}
