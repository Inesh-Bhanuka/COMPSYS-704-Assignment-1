/*
 * Filler plant: a valve and a flow meter.
 *
 * While the valve is open the plant meters out RATE millilitres per tick and
 * reports when it has reached the volume the controller asked for.
 */
FillerPlant(
		input signal enable, valveOpen;
		input Integer signal fillTarget;

		output signal filled;
		)
->
{
	int RATE = PlantTiming.rate(20);          // ml per tick

	int target = 0;
	int poured = 0;

	while(true){
		present(enable){
			present(valveOpen){
				present(fillTarget){
					target = (Integer)#fillTarget;
				}
				if(poured < target){
					poured += RATE;
					if(poured > target){ poured = target; }
				}
				// A target the plant cannot reach must not hang the machine.
				// Anything at or below zero is reported filled immediately:
				// the valve is open and there is nothing to deliver, so the
				// controller gets its answer and the line keeps moving. A
				// controller should not be able to deadlock a plant by asking
				// for an impossible volume, whatever put the number there.
				if(target <= 0 || poured >= target){
					emit filled;
				}
			}
			else {
				// Valve shut: this fill is over. Resetting here rather than on
				// a change of target is what lets two bottles in a row ask for
				// the same volume.
				target = 0;
				poured = 0;
			}
		}
		pause;
	}
}
