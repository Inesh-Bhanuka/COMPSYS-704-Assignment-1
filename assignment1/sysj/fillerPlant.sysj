/*
 * Filler plant: a valve and a flow meter.
 *
 * While the valve is open the plant meters out RATE millilitres per tick and
 * reports when it has reached the volume the controller asked for.
 */
FillerPlant(
		input signal enable, valveOpen;
		input Integer signal fillTarget;

		output signal filled;
		)
->
{
	int RATE = 20;          // ml per tick

	int target = 0;
	int poured = 0;

	while(true){
		present(enable){
			present(valveOpen){
				present(fillTarget){
					target = (Integer)#fillTarget;
				}
				if(poured < target){
					poured += RATE;
					if(poured > target){ poured = target; }
				}
				if(target > 0 && poured >= target){
					emit filled;
				}
			}
			else {
				// Valve shut: this fill is over. Resetting here rather than on
				// a change of target is what lets two bottles in a row ask for
				// the same volume.
				target = 0;
				poured = 0;
			}
		}
		pause;
	}
}
