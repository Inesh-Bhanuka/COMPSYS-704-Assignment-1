/*
 * Lid loader. Pushes a lid out of the magazine, picks it up with the vacuum
 * arm and places it on the bottle at the table.
 *
 * Refills itself when the magazine runs out, which stalls the table for a
 * cycle - that is the intended behaviour, not a fault.
 */
LidLoaderController(
		// from / to the Rotary Table
		input  WorkpieceTwin channel start;
		output WorkpieceTwin channel done;

		// the machine's own summary, out to the coordinator
		output LidLoaderTwin signal twin;

		// operating mode
		input Integer signal mode;

		// Hard reset: drop whatever is held and go back to idle. One tick,
		// no sequence to finish - the bottle it was working on no longer
		// exists anywhere else either.
		input signal reset;

		// from the plant
		input signal pusherExtended, pusherRetracted, lidAtPickup, WPgripped;
		input signal armAtSource, armAtDest, magazineEmpty, refilled;

		// to the plant
		output signal pusherExtend, vacOn, armSource, armDest, refill;

		// manual overrides - the operator panel attaches here
		input signal pusherExtendM, vacOnM, armSourceM, armDestM;
		input signal refillM;
		)
->
{
	signal auto, manual;

	{ // Mode select
		while(true){
			present(mode){
				// 0 automatic, 1 manual, 2 paused. Paused emits neither, so
				// every gate below waits and the operator panel is inert.
				if((Integer)#mode == 0){ emit auto; }
				else if((Integer)#mode == 1){ emit manual; }
			}
			pause;
		}
	}
	||
	{ // Auto
		LidLoaderTwin t = new LidLoaderTwin();
		int lids = 3;
		WorkpieceTwin w = null;
		boolean lidded = false;

		while(true){
			abort(immediate reset){
				receive start;
				w = (WorkpieceTwin)#start;


				// Normally the first filler has already flagged this, in which
				// case the bottle just reports that it is lidded and no second
				// rejection is recorded. The catch is the backstop for a
				// bottle that reaches the loader without passing a filler.
				lidded = false;
				if(w != null){
					if(w.catchFault("lid-fitted")){
						w.lid();
						w.reject(Machine.LID_LOADER, "lid already fitted");
					}
					lidded = w.isLidded();
				}

				if(lidded){
					System.out.println("[LID] " + w + " already has a lid fitted.");
				}
				else if(w != null){
                    t = new LidLoaderTwin();
                    t.setLidsRemaining(lids);
                    if(t.update(PlantClock.now(), MachineStatus.WORKING, "place", "placing lid on " + w.id)){
                        emit twin(t);
                    }
					pause;
					// Refill first if the magazine is out
					present(magazineEmpty){
						System.out.println("[LID] Magazine empty, refilling.");
						abort(immediate auto){ await(immediate refillM); }
						abort(immediate refilled){
							sustain refill;
						}
					}

					// Push a lid to the pick-up point, then retract.
					//
					// pusherExtended only says the cylinder moved - the plant
					// raises it whether or not a lid actually came out of the
					// magazine. lidAtPickup is the sensor that answers the
					// question the controller is really asking, so the fetch
					// waits on that. Without it, an empty magazine that the
					// refill check missed by a tick sends the arm to collect
					// nothing and the machine blocks forever on WPgripped,
					// taking the table's barrier down with it.
					abort(immediate auto){ await(immediate pusherExtendM); }
					abort(immediate pusherExtended){
						sustain pusherExtend;
					}
					await(immediate pusherRetracted);
					await(immediate lidAtPickup);

					// Load-bearing, not padding. The compiler splits the
					// generated state machine at every pause, and without one
					// here the fetch-and-place half does not fit in a single
					// method under the JVM's 64 KB limit. It costs one tick
					// between the lid arriving at the pick-up point and the
					// arm going for it.
					pause;

					// Fetch it
					abort(immediate auto){ await(immediate armSourceM); }
					abort(immediate armAtSource){
						sustain armSource;
					}
					abort(immediate auto){ await(immediate vacOnM); }
					abort(immediate WPgripped){
						sustain vacOn;
					}

					// Place it on the bottle
					abort(immediate auto){ await(immediate armDestM); }
					abort(immediate armAtDest){
						{ sustain armDest; } || { sustain vacOn; }
					}
					await(immediate !WPgripped);

					w.lid();
					lids--;
					if(lids < 0){ lids = 3; }
					t = new LidLoaderTwin();
					t.setLidsRemaining(lids);
					if(t.update(PlantClock.now(), MachineStatus.IDLE, "place", "lid on " + w.id)){
						emit twin(t);
					}
					System.out.println("[LID] Lid placed on " + w + ".");
				}
		

				send done(w);
			}
		

			pause;
		}
	}
}
